---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'Pink Noise Generator';
const pageDescription = 'Customizable pink/white/brown noise generator for relaxation and focus';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="noise-wrapper">
    <div class="container mx-auto px-4">
      <main class="noise-container">
        <h1 class="page-title">Custom Pink Noise Generator</h1>
        <p class="page-subtitle">Craft your perfect sound for relaxation, focus, and sleep</p>

        <!-- Player Card -->
        <section class="player-card">
          <div class="player-top">
            <button id="playBtn" class="play-button" aria-label="Play or pause noise">
              <svg id="iconPlay" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5.14v13.72c0 .8.87 1.3 1.56.9l11.2-6.86a1.05 1.05 0 0 0 0-1.8L9.56 4.24A1.05 1.05 0 0 0 8 5.14z"/>
              </svg>
              <svg id="iconPause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none">
                <rect x="6" y="5" width="4" height="14" rx="1.2"/>
                <rect x="14" y="5" width="4" height="14" rx="1.2"/>
              </svg>
            </button>
            <div class="player-meta">
              <div class="status-row">
                <span id="statusText" class="status-text">Ready when you are</span>
                <div id="eqBars" class="eq-bars" aria-hidden="true">
                  <span></span><span></span><span></span><span></span>
                </div>
              </div>
              <div class="noise-chips" id="noiseChips">
                <button class="chip" data-tilt="-1">White</button>
                <button class="chip active" data-tilt="0">Pink</button>
                <button class="chip" data-tilt="1">Brown</button>
                <button class="chip chip-custom" id="chipCustom" disabled>Custom</button>
              </div>
            </div>
          </div>

          <div class="volume-row">
            <svg class="vol-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.4 5.6a9 9 0 0 1 0 12.8"/>
            </svg>
            <input id="volume" type="range" min="0" max="1" step="0.01" value="0.5" aria-label="Volume" />
            <span class="val" id="volumeVal">50%</span>
          </div>

          <div class="timer-row">
            <label class="timer-label" for="sleepTimer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/>
              </svg>
              Sleep timer
            </label>
            <select id="sleepTimer">
              <option value="0">Off</option>
              <option value="15">15 min</option>
              <option value="30">30 min</option>
              <option value="45">45 min</option>
              <option value="60">60 min</option>
              <option value="90">90 min</option>
            </select>
            <button id="timerBadge" class="timer-badge" style="display:none" title="Cancel timer">--:--</button>
          </div>
        </section>

        <!-- Spectrum -->
        <canvas id="spectrum" aria-hidden="true"></canvas>

        <!-- Fine-tune Controls -->
        <section class="tune-section">
          <h2 class="section-heading">Fine-tune</h2>
          <div class="controls-grid">
            <div class="control">
              <div class="control-head">
                <span>Color Tilt</span>
                <span class="val" id="tiltVal">Pink</span>
              </div>
              <input id="tilt" type="range" min="-1" max="1" step="0.01" value="0" aria-label="Color tilt from white to brown" />
              <div class="range-ends"><span>White</span><span>Brown</span></div>
            </div>
            <div class="control">
              <div class="control-head">
                <span>Low Cut</span>
                <span class="val" id="lowcutVal">40 Hz</span>
              </div>
              <input id="lowcut" type="range" min="20" max="500" step="5" value="40" aria-label="Low cut frequency" />
              <div class="range-ends"><span>20 Hz</span><span>500 Hz</span></div>
            </div>
            <div class="control">
              <div class="control-head">
                <span>High Cut</span>
                <span class="val" id="highcutVal">8.0 kHz</span>
              </div>
              <input id="highcut" type="range" min="1000" max="16000" step="100" value="8000" aria-label="High cut frequency" />
              <div class="range-ends"><span>1 kHz</span><span>16 kHz</span></div>
            </div>
            <div class="control">
              <div class="control-head">
                <span>Wave Intensity</span>
                <span class="val" id="modDepthVal">10%</span>
              </div>
              <input id="modDepth" type="range" min="0" max="0.5" step="0.01" value="0.1" aria-label="Modulation depth" />
              <div class="range-ends"><span>Steady</span><span>Waves</span></div>
            </div>
            <div class="control">
              <div class="control-head">
                <span>Wave Speed</span>
                <span class="val" id="modSpeedVal">0.08 Hz</span>
              </div>
              <input id="modSpeed" type="range" min="0.02" max="1" step="0.01" value="0.08" aria-label="Modulation speed" />
              <div class="range-ends"><span>Slow</span><span>Fast</span></div>
            </div>
          </div>
        </section>

        <!-- Presets -->
        <section class="presets-section">
          <div class="presets-head">
            <h2 class="section-heading">Presets</h2>
            <button id="savePreset" class="btn-save">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/>
              </svg>
              Save current
            </button>
          </div>
          <div id="presetList" class="preset-list"></div>
        </section>

        <p class="shortcut-hint">
          <kbd>Space</kbd> play/pause &nbsp;·&nbsp; <kbd>↑</kbd><kbd>↓</kbd> volume
        </p>

        <!-- Info Section -->
        <div class="info-section">
          <div class="info-header">
            <div class="info-header-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
              </svg>
            </div>
            <div>
              <h2 class="info-title">About Noise Colors</h2>
              <p class="info-tagline">Understanding different types of noise for relaxation and focus</p>
            </div>
          </div>

          <div class="info-grid">
            <div class="info-card">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 6v6l4 2"/>
                </svg>
              </div>
              <h3 class="card-title">White Noise</h3>
              <p class="card-content">
                Contains all frequencies at equal intensity. Like the static from a TV or radio.
                Best for masking sudden environmental sounds and creating a consistent audio backdrop.
              </p>
            </div>

            <div class="info-card highlight-card">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                </svg>
              </div>
              <h3 class="card-title">Pink Noise</h3>
              <p class="card-content">
                Equal energy per octave, creating a balanced, natural sound. Similar to steady rainfall or rustling leaves.
                Research suggests pink noise may improve sleep quality and enhance memory consolidation.
              </p>
            </div>

            <div class="info-card">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
              </div>
              <h3 class="card-title">Brown Noise</h3>
              <p class="card-content">
                Deeper, more bass-heavy sound with energy decreasing by frequency. Like a powerful waterfall or distant thunder.
                Many find it more soothing than white or pink noise, especially for deep focus and sleep.
              </p>
            </div>

            <div class="info-card">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <h3 class="card-title">Use Cases</h3>
              <ul class="card-list">
                <li><strong>Focus:</strong> Mask distractions while working or studying</li>
                <li><strong>Sleep:</strong> Create consistent ambient sound to fall asleep</li>
                <li><strong>Tinnitus Relief:</strong> Mask ringing or buzzing sounds</li>
                <li><strong>Privacy:</strong> Make conversations less intelligible</li>
                <li><strong>Relaxation:</strong> Create a calming atmosphere</li>
              </ul>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Save Preset Modal -->
  <div id="saveModal" class="modal-overlay" style="display:none">
    <div class="modal-box">
      <h3>Save Preset</h3>
      <p>Give your current settings a name:</p>
      <input type="text" id="presetName" placeholder="e.g. Rainy Night" maxlength="40" />
      <div class="modal-actions">
        <button id="cancelSave" class="btn-ghost">Cancel</button>
        <button id="confirmSave" class="btn-primary">Save</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    (() => {
      const $ = (id: string) => document.getElementById(id)!;

      const playBtn = $('playBtn') as HTMLButtonElement;
      const iconPlay = $('iconPlay');
      const iconPause = $('iconPause');
      const statusText = $('statusText');
      const eqBars = $('eqBars');
      const chipCustom = $('chipCustom') as HTMLButtonElement;
      const canvas = $('spectrum') as HTMLCanvasElement;
      const c2d = canvas.getContext('2d')!;
      const timerSelect = $('sleepTimer') as HTMLSelectElement;
      const timerBadge = $('timerBadge') as HTMLButtonElement;
      const toastEl = $('toast');

      const sliderIds = ['volume', 'tilt', 'lowcut', 'highcut', 'modDepth', 'modSpeed'] as const;
      type SettingId = typeof sliderIds[number];
      const slider = (id: SettingId) => $(id) as HTMLInputElement;

      // ---------- Audio engine ----------
      let ctx: AudioContext | null = null;
      let workletReady = false;
      let srcNode: AudioNode | null = null;
      let shelfLow: BiquadFilterNode, shelfHigh: BiquadFilterNode,
          hpFilter: BiquadFilterNode, lpFilter: BiquadFilterNode,
          modNode: GainNode, lfo: OscillatorNode, lfoGain: GainNode,
          masterGain: GainNode, analyser: AnalyserNode;
      let isPlaying = false;
      let teardownTimer: number | null = null;

      const WORKLET_CODE = `
        class PinkNoiseProcessor extends AudioWorkletProcessor {
          constructor() { super(); this.s = []; }
          process(inputs, outputs) {
            const out = outputs[0];
            for (let c = 0; c < out.length; c++) {
              const st = this.s[c] || (this.s[c] = new Float64Array(7));
              const buf = out[c];
              let b0 = st[0], b1 = st[1], b2 = st[2], b3 = st[3], b4 = st[4], b5 = st[5], b6 = st[6];
              for (let i = 0; i < buf.length; i++) {
                const w = Math.random() * 2 - 1;
                b0 = 0.99886 * b0 + w * 0.0555179;
                b1 = 0.99332 * b1 + w * 0.0750759;
                b2 = 0.96900 * b2 + w * 0.1538520;
                b3 = 0.86650 * b3 + w * 0.3104856;
                b4 = 0.55000 * b4 + w * 0.5329522;
                b5 = -0.7616 * b5 - w * 0.0168980;
                buf[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362) * 0.11;
                b6 = w * 0.115926;
              }
              st[0]=b0; st[1]=b1; st[2]=b2; st[3]=b3; st[4]=b4; st[5]=b5; st[6]=b6;
            }
            return true;
          }
        }
        registerProcessor('pink-noise', PinkNoiseProcessor);
      `;

      async function ensureContext(): Promise<AudioContext> {
        if (!ctx) {
          ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
          if (ctx.audioWorklet) {
            try {
              const blob = new Blob([WORKLET_CODE], { type: 'application/javascript' });
              await ctx.audioWorklet.addModule(URL.createObjectURL(blob));
              workletReady = true;
            } catch { workletReady = false; }
          }
        }
        if (ctx.state === 'suspended') await ctx.resume();
        return ctx;
      }

      function createNoiseSource(ac: AudioContext): AudioNode {
        if (workletReady) {
          return new AudioWorkletNode(ac, 'pink-noise', {
            numberOfInputs: 0,
            numberOfOutputs: 1,
            outputChannelCount: [2],
          });
        }
        // Fallback: stereo ScriptProcessor with independent generators per channel
        const node = ac.createScriptProcessor(4096, 0, 2);
        const state = [new Float64Array(7), new Float64Array(7)];
        node.onaudioprocess = (e) => {
          for (let ch = 0; ch < 2; ch++) {
            const st = state[ch];
            const out = e.outputBuffer.getChannelData(ch);
            let b0 = st[0], b1 = st[1], b2 = st[2], b3 = st[3], b4 = st[4], b5 = st[5], b6 = st[6];
            for (let i = 0; i < out.length; i++) {
              const w = Math.random() * 2 - 1;
              b0 = 0.99886 * b0 + w * 0.0555179;
              b1 = 0.99332 * b1 + w * 0.0750759;
              b2 = 0.96900 * b2 + w * 0.1538520;
              b3 = 0.86650 * b3 + w * 0.3104856;
              b4 = 0.55000 * b4 + w * 0.5329522;
              b5 = -0.7616 * b5 - w * 0.0168980;
              out[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362) * 0.11;
              b6 = w * 0.115926;
            }
            st[0]=b0; st[1]=b1; st[2]=b2; st[3]=b3; st[4]=b4; st[5]=b5; st[6]=b6;
          }
        };
        return node;
      }

      const num = (id: SettingId) => parseFloat(slider(id).value);

      async function startNoise() {
        const ac = await ensureContext();
        if (teardownTimer !== null) { clearTimeout(teardownTimer); teardownTimer = null; }

        srcNode = createNoiseSource(ac);

        shelfLow = ac.createBiquadFilter();
        shelfLow.type = 'lowshelf';
        shelfLow.frequency.value = 500;

        shelfHigh = ac.createBiquadFilter();
        shelfHigh.type = 'highshelf';
        shelfHigh.frequency.value = 2000;

        hpFilter = ac.createBiquadFilter();
        hpFilter.type = 'highpass';
        hpFilter.frequency.value = num('lowcut');

        lpFilter = ac.createBiquadFilter();
        lpFilter.type = 'lowpass';
        lpFilter.frequency.value = num('highcut');

        modNode = ac.createGain();
        modNode.gain.value = 1;
        lfo = ac.createOscillator();
        lfo.frequency.value = num('modSpeed');
        lfoGain = ac.createGain();
        lfoGain.gain.value = num('modDepth');
        lfo.connect(lfoGain).connect(modNode.gain);
        lfo.start();

        masterGain = ac.createGain();
        analyser = ac.createAnalyser();
        analyser.fftSize = 2048;
        analyser.smoothingTimeConstant = 0.82;

        applyTilt(num('tilt'));

        srcNode.connect(shelfLow).connect(shelfHigh).connect(hpFilter)
          .connect(lpFilter).connect(modNode).connect(masterGain)
          .connect(analyser).connect(ac.destination);

        // Fade in
        const now = ac.currentTime;
        masterGain.gain.setValueAtTime(0.0001, now);
        masterGain.gain.exponentialRampToValueAtTime(Math.max(0.001, num('volume')), now + 0.6);

        isPlaying = true;
        updatePlayUI();
        startSleepTimerIfSet();
        requestAnimationFrame(drawSpectrum);
      }

      function stopNoise(fadeSec = 0.4) {
        if (!ctx || !isPlaying) return;
        const now = ctx.currentTime;
        masterGain.gain.cancelScheduledValues(now);
        masterGain.gain.setTargetAtTime(0.0001, now, fadeSec / 3);
        isPlaying = false;
        cancelSleepTimer(false);
        updatePlayUI();
        const nodes = [srcNode, shelfLow, shelfHigh, hpFilter, lpFilter, modNode, masterGain, analyser];
        const oldLfo = lfo;
        teardownTimer = window.setTimeout(() => {
          try { oldLfo.stop(); } catch { /* already stopped */ }
          nodes.forEach(n => { try { n?.disconnect(); } catch { /* ok */ } });
          srcNode = null;
          teardownTimer = null;
        }, fadeSec * 1000 + 200);
      }

      function applyTilt(t: number) {
        if (!ctx || !srcNode) return;
        const now = ctx.currentTime;
        shelfLow.gain.setTargetAtTime(t * 10, now, 0.05);
        shelfHigh.gain.setTargetAtTime(-t * 10, now, 0.05);
      }

      function updatePlayUI() {
        iconPlay.style.display = isPlaying ? 'none' : '';
        iconPause.style.display = isPlaying ? '' : 'none';
        playBtn.classList.toggle('playing', isPlaying);
        eqBars.classList.toggle('animating', isPlaying);
        statusText.textContent = isPlaying ? 'Now playing' : 'Paused';
      }

      playBtn.addEventListener('click', () => {
        if (isPlaying) stopNoise();
        else startNoise();
      });

      // ---------- Setting displays & realtime updates ----------
      function tiltLabel(t: number): string {
        if (t < -0.6) return 'White';
        if (t < -0.2) return 'Bright';
        if (t <= 0.2) return 'Pink';
        if (t <= 0.6) return 'Warm';
        return 'Brown';
      }

      function refreshDisplay(id: SettingId) {
        const v = num(id);
        switch (id) {
          case 'volume': $('volumeVal').textContent = `${Math.round(v * 100)}%`; break;
          case 'tilt': $('tiltVal').textContent = tiltLabel(v); break;
          case 'lowcut': $('lowcutVal').textContent = `${v} Hz`; break;
          case 'highcut': $('highcutVal').textContent = v >= 1000 ? `${(v / 1000).toFixed(1)} kHz` : `${v} Hz`; break;
          case 'modDepth': $('modDepthVal').textContent = `${Math.round(v * 100)}%`; break;
          case 'modSpeed': $('modSpeedVal').textContent = `${v.toFixed(2)} Hz`; break;
        }
      }

      function applySetting(id: SettingId) {
        refreshDisplay(id);
        if (id === 'tilt') syncChips();
        if (!ctx || !srcNode) return;
        const now = ctx.currentTime;
        const v = num(id);
        switch (id) {
          case 'volume':
            if (isPlaying) masterGain.gain.setTargetAtTime(Math.max(0.0001, v), now, 0.05);
            break;
          case 'tilt': applyTilt(v); break;
          case 'lowcut': hpFilter.frequency.setTargetAtTime(v, now, 0.05); break;
          case 'highcut': lpFilter.frequency.setTargetAtTime(v, now, 0.05); break;
          case 'modDepth': lfoGain.gain.setTargetAtTime(v, now, 0.05); break;
          case 'modSpeed': lfo.frequency.setTargetAtTime(v, now, 0.05); break;
        }
      }

      sliderIds.forEach(id => {
        slider(id).addEventListener('input', () => applySetting(id));
        refreshDisplay(id);
      });

      // ---------- Noise color chips ----------
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#noiseChips .chip[data-tilt]'));
      chips.forEach(chip => {
        chip.addEventListener('click', () => {
          slider('tilt').value = chip.dataset.tilt!;
          applySetting('tilt');
        });
      });

      function syncChips() {
        const t = num('tilt');
        let matched = false;
        chips.forEach(chip => {
          const isMatch = Math.abs(parseFloat(chip.dataset.tilt!) - t) < 0.03;
          chip.classList.toggle('active', isMatch);
          if (isMatch) matched = true;
        });
        chipCustom.classList.toggle('active', !matched);
        chipCustom.style.visibility = matched ? 'hidden' : 'visible';
      }
      syncChips();

      // ---------- Sleep timer ----------
      let timerInterval: number | null = null;
      let timerEndsAt = 0;

      function startSleepTimerIfSet() {
        cancelSleepTimer(false);
        const mins = parseInt(timerSelect.value, 10);
        if (!mins || !isPlaying) return;
        timerEndsAt = Date.now() + mins * 60000;
        timerBadge.style.display = '';
        tickTimer();
        timerInterval = window.setInterval(tickTimer, 1000);
      }

      function tickTimer() {
        const remain = timerEndsAt - Date.now();
        if (remain <= 0) {
          cancelSleepTimer(true);
          stopNoise(3);
          showToast('Sleep timer finished — fading out');
          return;
        }
        const m = Math.floor(remain / 60000);
        const s = Math.floor((remain % 60000) / 1000);
        timerBadge.textContent = `${m}:${String(s).padStart(2, '0')}`;
      }

      function cancelSleepTimer(resetSelect: boolean) {
        if (timerInterval !== null) { clearInterval(timerInterval); timerInterval = null; }
        timerBadge.style.display = 'none';
        if (resetSelect) timerSelect.value = '0';
      }

      timerSelect.addEventListener('change', () => {
        if (isPlaying) {
          startSleepTimerIfSet();
          const mins = parseInt(timerSelect.value, 10);
          if (mins) showToast(`Will fade out in ${mins} minutes`);
        }
      });

      timerBadge.addEventListener('click', () => {
        cancelSleepTimer(true);
        showToast('Sleep timer cancelled');
      });

      // ---------- Presets ----------
      type Settings = Record<SettingId, number>;
      const STORAGE_KEY = 'pinkNoisePresets';

      const BUILT_IN: Array<{ name: string; s: Settings }> = [
        { name: 'Deep Sleep',     s: { volume: 0.45, tilt: 0.85, lowcut: 20,  highcut: 1500,  modDepth: 0.06, modSpeed: 0.05 } },
        { name: 'Focus',          s: { volume: 0.40, tilt: 0,    lowcut: 80,  highcut: 8000,  modDepth: 0,    modSpeed: 0.10 } },
        { name: 'Ocean Waves',    s: { volume: 0.50, tilt: 0.6,  lowcut: 30,  highcut: 3000,  modDepth: 0.40, modSpeed: 0.07 } },
        { name: 'Airplane Cabin', s: { volume: 0.45, tilt: 0.5,  lowcut: 40,  highcut: 2500,  modDepth: 0.04, modSpeed: 0.03 } },
        { name: 'Bright Static',  s: { volume: 0.35, tilt: -0.8, lowcut: 200, highcut: 16000, modDepth: 0,    modSpeed: 0.10 } },
      ];

      function getUserPresets(): Record<string, Partial<Record<SettingId, string | number>>> {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
        catch { return {}; }
      }

      function clamp(v: number, min: number, max: number) { return Math.min(max, Math.max(min, v)); }

      function applyPreset(s: Partial<Record<SettingId, string | number>>) {
        sliderIds.forEach(id => {
          if (s[id] === undefined) return;
          const el = slider(id);
          const v = clamp(parseFloat(String(s[id])), parseFloat(el.min), parseFloat(el.max));
          el.value = String(v);
          applySetting(id);
        });
      }

      function renderPresets() {
        const list = $('presetList');
        list.innerHTML = '';
        BUILT_IN.forEach(p => {
          const btn = document.createElement('button');
          btn.className = 'preset-chip built-in';
          btn.innerHTML = `<span class="preset-star">★</span>${escapeHtml(p.name)}`;
          btn.addEventListener('click', () => { applyPreset(p.s); showToast(`Applied "${p.name}"`); });
          list.appendChild(btn);
        });
        const user = getUserPresets();
        Object.keys(user).forEach(name => {
          const wrap = document.createElement('div');
          wrap.className = 'preset-chip user';
          const btn = document.createElement('button');
          btn.className = 'preset-apply';
          btn.textContent = name;
          btn.addEventListener('click', () => { applyPreset(user[name]); showToast(`Applied "${name}"`); });
          const del = document.createElement('button');
          del.className = 'preset-delete';
          del.setAttribute('aria-label', `Delete preset ${name}`);
          del.textContent = '×';
          del.addEventListener('click', (e) => {
            e.stopPropagation();
            const presets = getUserPresets();
            delete presets[name];
            localStorage.setItem(STORAGE_KEY, JSON.stringify(presets));
            renderPresets();
            showToast(`Deleted "${name}"`);
          });
          wrap.appendChild(btn);
          wrap.appendChild(del);
          list.appendChild(wrap);
        });
      }

      function escapeHtml(s: string) {
        return s.replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]!));
      }

      renderPresets();

      // Save modal
      const saveModal = $('saveModal');
      const presetNameInput = $('presetName') as HTMLInputElement;

      $('savePreset').addEventListener('click', () => {
        saveModal.style.display = 'flex';
        presetNameInput.value = '';
        setTimeout(() => presetNameInput.focus(), 50);
      });
      $('cancelSave').addEventListener('click', closeSaveModal);
      saveModal.addEventListener('click', e => { if (e.target === saveModal) closeSaveModal(); });
      presetNameInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') confirmSave();
        if (e.key === 'Escape') closeSaveModal();
      });
      $('confirmSave').addEventListener('click', confirmSave);

      function closeSaveModal() { saveModal.style.display = 'none'; }

      function confirmSave() {
        const name = presetNameInput.value.trim();
        if (!name) { presetNameInput.focus(); return; }
        const presets = getUserPresets();
        const settings: Partial<Record<SettingId, number>> = {};
        sliderIds.forEach(id => { settings[id] = num(id); });
        presets[name] = settings;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(presets));
        closeSaveModal();
        renderPresets();
        showToast(`Saved "${name}"`);
      }

      // ---------- Toast ----------
      let toastTimer: number | null = null;
      function showToast(msg: string) {
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        if (toastTimer !== null) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2400);
      }

      // ---------- Keyboard shortcuts ----------
      window.addEventListener('keydown', e => {
        const t = e.target as HTMLElement;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'SELECT' || t.tagName === 'TEXTAREA')) return;
        if (e.code === 'Space') {
          e.preventDefault();
          if (isPlaying) stopNoise(); else startNoise();
        } else if (e.code === 'ArrowUp' || e.code === 'ArrowDown') {
          e.preventDefault();
          const el = slider('volume');
          const delta = e.code === 'ArrowUp' ? 0.05 : -0.05;
          el.value = String(clamp(num('volume') + delta, 0, 1));
          applySetting('volume');
        }
      });

      // ---------- Spectrum visualization ----------
      function resizeCanvas() {
        const dpr = window.devicePixelRatio || 1;
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
        }
      }
      new ResizeObserver(resizeCanvas).observe(canvas);
      resizeCanvas();
      drawIdle();

      const BAR_COUNT = 56;

      function drawSpectrum() {
        if (!isPlaying) { drawIdle(); return; }
        requestAnimationFrame(drawSpectrum);
        resizeCanvas();
        const W = canvas.width, H = canvas.height;
        const data = new Uint8Array(analyser.frequencyBinCount);
        analyser.getByteFrequencyData(data);

        c2d.clearRect(0, 0, W, H);
        const bg = c2d.createLinearGradient(0, 0, 0, H);
        bg.addColorStop(0, '#0b0f19');
        bg.addColorStop(1, '#111827');
        c2d.fillStyle = bg;
        c2d.fillRect(0, 0, W, H);

        const gap = W * 0.004;
        const barW = (W - gap * (BAR_COUNT + 1)) / BAR_COUNT;
        for (let i = 0; i < BAR_COUNT; i++) {
          // Perceptual (power-scaled) bin mapping so lows aren't cramped
          const lo = Math.floor(Math.pow(i / BAR_COUNT, 2.2) * (data.length - 1));
          const hi = Math.max(lo + 1, Math.floor(Math.pow((i + 1) / BAR_COUNT, 2.2) * (data.length - 1)));
          let sum = 0;
          for (let j = lo; j < hi; j++) sum += data[j];
          const v = sum / (hi - lo) / 255;
          const barH = Math.max(H * 0.015, v * H * 0.92);
          const x = gap + i * (barW + gap);
          const y = H - barH;
          const grad = c2d.createLinearGradient(0, y, 0, H);
          grad.addColorStop(0, '#fbbf24');
          grad.addColorStop(0.55, '#f76b1c');
          grad.addColorStop(1, '#7c2d12');
          c2d.fillStyle = grad;
          const r = Math.min(barW / 2, 6);
          c2d.beginPath();
          c2d.moveTo(x, H);
          c2d.lineTo(x, y + r);
          c2d.arcTo(x, y, x + r, y, r);
          c2d.arcTo(x + barW, y, x + barW, y + r, r);
          c2d.lineTo(x + barW, H);
          c2d.closePath();
          c2d.fill();
        }
      }

      function drawIdle() {
        resizeCanvas();
        const W = canvas.width, H = canvas.height;
        const bg = c2d.createLinearGradient(0, 0, 0, H);
        bg.addColorStop(0, '#0b0f19');
        bg.addColorStop(1, '#111827');
        c2d.fillStyle = bg;
        c2d.fillRect(0, 0, W, H);
        c2d.strokeStyle = 'rgba(243, 169, 60, 0.35)';
        c2d.lineWidth = Math.max(1, H * 0.008);
        c2d.beginPath();
        c2d.moveTo(0, H * 0.85);
        c2d.lineTo(W, H * 0.85);
        c2d.stroke();
        c2d.fillStyle = 'rgba(255,255,255,0.45)';
        c2d.font = `${Math.max(12, H * 0.09)}px Inter, sans-serif`;
        c2d.textAlign = 'center';
        c2d.textBaseline = 'middle';
        c2d.fillText('Press play to see the spectrum', W / 2, H / 2);
      }
    })();
  </script>

