---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'Memory Challenge';
const pageDescription = 'Test your memory by tapping numbers in order';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="memory-wrapper">
    <div class="container mx-auto px-4">
      <main class="memory-container">
        <div id="gameContainer">

          <!-- Splash / mode select -->
          <div id="splash">
            <h1 class="page-title">Number Memory Challenge</h1>
            <p class="subtitle">Memorize the numbers, then tap them in order — how far can you go?</p>
            <div class="mode-grid" id="modeButtons">
              <button data-mode="easy" class="mode-card">
                <span class="mode-name">Easy</span>
                <span class="mode-desc">3 numbers · relaxed pace</span>
                <span class="mode-best" data-best="easy"></span>
              </button>
              <button data-mode="medium" class="mode-card">
                <span class="mode-name">Medium</span>
                <span class="mode-desc">5 numbers · steady pace</span>
                <span class="mode-best" data-best="medium"></span>
              </button>
              <button data-mode="hard" class="mode-card">
                <span class="mode-name">Hard</span>
                <span class="mode-desc">7 numbers · quick fade</span>
                <span class="mode-best" data-best="hard"></span>
              </button>
              <button data-mode="nightmare" class="mode-card">
                <span class="mode-name">Nightmare</span>
                <span class="mode-desc">9 numbers · blink and lose</span>
                <span class="mode-best" data-best="nightmare"></span>
              </button>
            </div>
          </div>

          <!-- Game screen -->
          <div id="gameScreen" style="display:none">
            <div class="hud">
              <div class="hud-item hud-score">
                <span class="hud-label">Score</span>
                <span class="hud-value" id="scoreValue">0</span>
              </div>
              <div class="hud-item hud-round">
                <span class="hud-label" id="modeLabel">Round</span>
                <span class="hud-value" id="roundValue">1</span>
              </div>
              <div class="hud-item hud-lives">
                <span class="hud-label">Lives</span>
                <span class="hud-value hearts" id="heartsValue">❤️❤️❤️</span>
              </div>
              <button id="muteBtn" class="mute-btn" aria-label="Toggle sound">🔊</button>
            </div>
            <div class="memorize-bar-track" id="memorizeBarTrack">
              <div class="memorize-bar" id="memorizeBar"></div>
            </div>
            <div class="canvas-holder">
              <canvas id="gameCanvas"></canvas>
            </div>
            <div class="phase-hint" id="phaseHint"></div>
            <div class="game-footer">
              <button id="quitBtn" class="quit-btn">← Quit to menu</button>
              <span class="streak-badge" id="streakBadge" style="display:none"></span>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <script>
    (() => {
      const $ = (id: string) => document.getElementById(id)!;

      const CONFIG = {
        INITIAL_DURATION: { easy: 2.5, medium: 3.0, hard: 4.0, nightmare: 5.0 } as Record<string, number>,
        DURATION_DECREMENT: 0.15,
        MIN_DURATION: 0.3,
        POINTS_PER_CORRECT: 10,
        ROUND_BONUS: { easy: 50, medium: 100, hard: 150, nightmare: 200 } as Record<string, number>,
        CIRCLE_COUNTS: { easy: 3, medium: 5, hard: 7, nightmare: 9 } as Record<string, number>,
        STREAK_BONUS: 25,
      };

      const HS_KEY = 'memoryChallengeHighScores';
      const MUTE_KEY = 'memoryChallengeMuted';

      type Circle = {
        x: number; y: number; r: number; number: number;
        clicked: boolean;
        spawnAt: number;       // ms timestamp for pop-in animation
        clickedAt: number;     // ms timestamp for click ripple
        wrongAt: number;       // ms timestamp for wrong flash
      };

      type Phase = 'idle' | 'countdown' | 'memorize' | 'recall' | 'reveal' | 'gameover';

      let mode = 'easy';
      let phase: Phase = 'idle';
      let score = 0;
      let lives = 3;
      let roundNumber = 1;
      let streak = 0;
      let currentDuration = 2.5;
      let circles: Circle[] = [];
      let currentIndex = 0;
      let countdownValue = 3;
      let countdownStart = 0;
      let revealStart = 0;
      let gameOverAt = 0;
      let newHighScore = false;
      let rafId: number | null = null;
      const timers: number[] = [];

      const canvas = $('gameCanvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      const splash = $('splash');
      const gameScreen = $('gameScreen');
      const scoreValue = $('scoreValue');
      const roundValue = $('roundValue');
      const heartsValue = $('heartsValue');
      const modeLabel = $('modeLabel');
      const memorizeBar = $('memorizeBar');
      const memorizeBarTrack = $('memorizeBarTrack');
      const phaseHint = $('phaseHint');
      const streakBadge = $('streakBadge');
      const muteBtn = $('muteBtn');

      const vibrate = (p: number | number[]) => {
        if ('vibrate' in navigator) { try { navigator.vibrate(p); } catch { /* unsupported */ } }
      };

      // ---------- Sound ----------
      let audioCtx: AudioContext | null = null;
      let muted = localStorage.getItem(MUTE_KEY) === '1';
      updateMuteBtn();

      function ac(): AudioContext {
        if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        return audioCtx;
      }

      function tone(freq: number, dur: number, type: OscillatorType = 'sine', vol = 0.25, when = 0, endFreq?: number) {
        if (muted) return;
        const a = ac();
        const osc = a.createOscillator();
        const g = a.createGain();
        osc.connect(g).connect(a.destination);
        osc.type = type;
        const t0 = a.currentTime + when;
        osc.frequency.setValueAtTime(freq, t0);
        if (endFreq) osc.frequency.exponentialRampToValueAtTime(endFreq, t0 + dur);
        g.gain.setValueAtTime(vol, t0);
        g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
        osc.start(t0);
        osc.stop(t0 + dur);
      }

      const sfx = {
        beep: () => tone(800, 0.1),
        go: () => tone(1100, 0.18, 'sine', 0.3),
        correct: (idx: number) => tone(523.25 * Math.pow(1.06, idx), 0.18, 'sine', 0.28, 0, 659.25 * Math.pow(1.06, idx)),
        wrong: () => tone(140, 0.6, 'sawtooth', 0.28, 0, 60),
        roundComplete: () => { [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => tone(f, 0.18, 'sine', 0.22, i * 0.12)); },
        gameOver: () => { [392, 330, 262, 196].forEach((f, i) => tone(f, 0.3, 'triangle', 0.22, i * 0.2)); },
        highScore: () => { [523.25, 659.25, 783.99, 1046.5, 1318.5].forEach((f, i) => tone(f, 0.22, 'sine', 0.22, i * 0.1)); },
      };

      muteBtn.addEventListener('click', () => {
        muted = !muted;
        localStorage.setItem(MUTE_KEY, muted ? '1' : '0');
        updateMuteBtn();
      });

      function updateMuteBtn() {
        muteBtn.textContent = muted ? '🔇' : '🔊';
      }

      // ---------- High scores ----------
      function getHighScores(): Record<string, number> {
        try { return JSON.parse(localStorage.getItem(HS_KEY) || '{}'); } catch { return {}; }
      }

      function renderBests() {
        const hs = getHighScores();
        document.querySelectorAll<HTMLElement>('[data-best]').forEach(el => {
          const m = el.dataset.best!;
          el.textContent = hs[m] ? `Best: ${hs[m]}` : 'Not played yet';
        });
      }
      renderBests();

      // ---------- Canvas sizing (HiDPI) ----------
      let cssW = 0, cssH = 0;

      function resizeCanvas() {
        const dpr = window.devicePixelRatio || 1;
        cssW = canvas.clientWidth;
        cssH = canvas.clientHeight;
        canvas.width = Math.round(cssW * dpr);
        canvas.height = Math.round(cssH * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      window.addEventListener('resize', () => { resizeCanvas(); });

      function isDark() { return document.documentElement.classList.contains('dark'); }

      const palette = () => isDark()
        ? {
            text: '#f3f4f6', sub: '#9ca3af',
            circleShown: '#34d399', circleShownEdge: '#059669',
            circleHidden: '#4b5563', circleHiddenEdge: '#374151',
            circleDone: '#10b981', circleDoneEdge: '#047857',
            circleWrong: '#ef4444',
            num: '#052e16', numHidden: '#111827',
          }
        : {
            text: '#2c3e50', sub: '#7f8c8d',
            circleShown: '#6ee7b7', circleShownEdge: '#10b981',
            circleHidden: '#fde8d7', circleHiddenEdge: '#f0c4a0',
            circleDone: '#86efac', circleDoneEdge: '#22c55e',
            circleWrong: '#ef4444',
            num: '#14532d', numHidden: '#7c2d12',
          };

      // ---------- Layout circles ----------
      function circleRadius(): number {
        // scale radius down a bit on small screens
        return Math.max(30, Math.min(44, cssW / 9));
      }

      function generateCircles(count: number) {
        circles = [];
        const r = circleRadius();
        const pad = r + 14;
        const now = performance.now();
        for (let i = 0; i < count; i++) {
          let x = 0, y = 0, ok = false;
          for (let attempt = 0; attempt < 200 && !ok; attempt++) {
            x = pad + Math.random() * (cssW - 2 * pad);
            y = pad + Math.random() * (cssH - 2 * pad);
            ok = circles.every(c => Math.hypot(x - c.x, y - c.y) >= r * 2.4);
          }
          circles.push({ x, y, r, number: i + 1, clicked: false, spawnAt: now + i * 70, clickedAt: 0, wrongAt: 0 });
        }
      }

      // ---------- Render loop ----------
      function loop() {
        rafId = requestAnimationFrame(loop);
        draw(performance.now());
      }

      function startLoop() {
        if (rafId === null) rafId = requestAnimationFrame(loop);
      }

      function stopLoop() {
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      }

      const easeOutBack = (t: number) => {
        const c1 = 1.70158, c3 = c1 + 1;
        return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
      };

      function draw(now: number) {
        const p = palette();
        ctx.clearRect(0, 0, cssW, cssH);

        if (phase === 'countdown') {
          const elapsed = (now - countdownStart) / 1000;
          const t = Math.min(1, elapsed % 0.95 / 0.4);
          const scale = 0.6 + 0.4 * easeOutBack(Math.min(1, t));
          ctx.save();
          ctx.translate(cssW / 2, cssH / 2);
          ctx.scale(scale, scale);
          ctx.globalAlpha = 1 - Math.max(0, (elapsed % 0.95 - 0.6)) * 2.5;
          ctx.fillStyle = p.text;
          ctx.font = 'bold 120px Inter, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(String(countdownValue), 0, 0);
          ctx.restore();
          return;
        }

        // 'idle' with circles present covers the brief round-complete transition
        if (phase === 'memorize' || phase === 'recall' || phase === 'reveal' || (phase === 'idle' && circles.length)) {
          drawCircles(now, p);
        }

        if (phase === 'reveal') {
          drawSkull(now, p);
        }

        if (phase === 'gameover') {
          drawGameOver(now, p);
        }
      }

      function drawCircles(now: number, p: ReturnType<typeof palette>) {
        const showNumbers = phase === 'memorize' || phase === 'reveal';
        circles.forEach(c => {
          // pop-in scale
          const born = Math.min(1, Math.max(0, (now - c.spawnAt) / 320));
          if (born <= 0) return;
          let scale = easeOutBack(born);

          // click pulse
          if (c.clickedAt) {
            const ct = Math.min(1, (now - c.clickedAt) / 260);
            scale *= 1 + 0.18 * Math.sin(ct * Math.PI);
          }

          // wrong shake
          let dx = 0;
          if (c.wrongAt) {
            const wt = (now - c.wrongAt) / 1000;
            if (wt < 0.45) dx = Math.sin(wt * 42) * 6 * (1 - wt / 0.45);
          }

          const r = c.r * scale;
          const isWrongFlash = c.wrongAt && now - c.wrongAt < 450;

          ctx.save();
          ctx.translate(c.x + dx, c.y);

          // shadow
          ctx.shadowColor = 'rgba(0,0,0,0.18)';
          ctx.shadowBlur = 10;
          ctx.shadowOffsetY = 3;

          ctx.beginPath();
          ctx.arc(0, 0, r, 0, Math.PI * 2);
          if (isWrongFlash) ctx.fillStyle = p.circleWrong;
          else if (c.clicked) ctx.fillStyle = p.circleDone;
          else if (showNumbers) ctx.fillStyle = p.circleShown;
          else ctx.fillStyle = p.circleHidden;
          ctx.fill();
          ctx.shadowColor = 'transparent';
          ctx.lineWidth = 3;
          ctx.strokeStyle = c.clicked ? p.circleDoneEdge : showNumbers ? p.circleShownEdge : p.circleHiddenEdge;
          ctx.stroke();

          // ripple on click
          if (c.clickedAt) {
            const rt = (now - c.clickedAt) / 500;
            if (rt < 1) {
              ctx.beginPath();
              ctx.arc(0, 0, r + rt * 26, 0, Math.PI * 2);
              ctx.strokeStyle = `rgba(34, 197, 94, ${0.5 * (1 - rt)})`;
              ctx.lineWidth = 3;
              ctx.stroke();
            }
          }

          if (showNumbers || c.clicked) {
            ctx.fillStyle = isWrongFlash ? '#fff' : p.num;
            ctx.font = `bold ${Math.round(r * 0.62)}px Inter, sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(String(c.number), 0, 1);
          } else {
            // subtle "?" on hidden circles
            ctx.fillStyle = p.numHidden;
            ctx.globalAlpha = 0.35;
            ctx.font = `bold ${Math.round(r * 0.55)}px Inter, sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('?', 0, 1);
            ctx.globalAlpha = 1;
          }
          ctx.restore();
        });
      }

      function drawSkull(now: number, p: ReturnType<typeof palette>) {
        const t = Math.min(1, (now - revealStart) / 350);
        const cx = cssW / 2, cy = cssH / 2;
        const size = 130 * easeOutBack(t);

        ctx.save();
        ctx.globalAlpha = 0.88 * t;

        ctx.fillStyle = p.text;
        ctx.strokeStyle = p.text;

        // head
        ctx.beginPath();
        ctx.arc(cx, cy - size * 0.1, size * 0.4, 0, Math.PI * 2);
        ctx.fill();
        // eyes
        ctx.fillStyle = isDark() ? '#111827' : '#000';
        ctx.beginPath(); ctx.arc(cx - size * 0.15, cy - size * 0.15, size * 0.08, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(cx + size * 0.15, cy - size * 0.15, size * 0.08, 0, Math.PI * 2); ctx.fill();
        // nose
        ctx.fillStyle = p.text;
        ctx.beginPath();
        ctx.moveTo(cx, cy - size * 0.05);
        ctx.lineTo(cx - size * 0.07, cy + size * 0.05);
        ctx.lineTo(cx + size * 0.07, cy + size * 0.05);
        ctx.closePath(); ctx.fill();
        // teeth
        ctx.fillRect(cx - size * 0.12, cy + size * 0.1, size * 0.24, size * 0.14);
        ctx.fillStyle = isDark() ? '#111827' : '#000';
        for (let i = 1; i < 4; i++) {
          ctx.fillRect(cx - size * 0.12 + i * size * 0.06 - size * 0.01, cy + size * 0.1, size * 0.02, size * 0.14);
        }
        // crossbones
        ctx.strokeStyle = p.text;
        ctx.lineWidth = 8;
        ctx.lineCap = 'round';
        ctx.beginPath(); ctx.moveTo(cx - size * 0.5, cy + size * 0.32); ctx.lineTo(cx + size * 0.5, cy - size * 0.32); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx + size * 0.5, cy + size * 0.32); ctx.lineTo(cx - size * 0.5, cy - size * 0.32); ctx.stroke();
        ctx.fillStyle = p.text;
        [[-0.5, 0.32], [0.5, -0.32], [0.5, 0.32], [-0.5, -0.32]].forEach(([fx, fy]) => {
          ctx.beginPath();
          ctx.arc(cx + size * fx, cy + size * fy, size * 0.11, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.restore();
      }

      let playAgainRect = { x: 0, y: 0, w: 0, h: 0 };
      let menuRect = { x: 0, y: 0, w: 0, h: 0 };

      function drawGameOver(now: number, p: ReturnType<typeof palette>) {
        const t = Math.min(1, (now - gameOverAt) / 450);
        const cx = cssW / 2;
        ctx.save();
        ctx.globalAlpha = t;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        ctx.fillStyle = p.text;
        ctx.font = 'bold 46px Inter, sans-serif';
        ctx.fillText('Game Over', cx, cssH * 0.24);

        if (newHighScore) {
          ctx.fillStyle = '#f59e0b';
          ctx.font = 'bold 22px Inter, sans-serif';
          const bounce = 1 + 0.06 * Math.sin(now / 180);
          ctx.save();
          ctx.translate(cx, cssH * 0.34);
          ctx.scale(bounce, bounce);
          ctx.fillText('🏆 New High Score!', 0, 0);
          ctx.restore();
        }

        ctx.fillStyle = p.text;
        ctx.font = 'bold 34px Inter, sans-serif';
        ctx.fillText(`${score} points`, cx, cssH * 0.44);

        ctx.fillStyle = p.sub;
        ctx.font = '17px Inter, sans-serif';
        const hs = getHighScores();
        ctx.fillText(`Round ${roundNumber} · ${mode.charAt(0).toUpperCase() + mode.slice(1)} · Best: ${hs[mode] ?? score}`, cx, cssH * 0.52);

        // buttons
        const bw = Math.min(230, cssW * 0.7), bh = 52, gap = 14;
        playAgainRect = { x: cx - bw / 2, y: cssH * 0.60, w: bw, h: bh };
        menuRect = { x: cx - bw / 2, y: cssH * 0.60 + bh + gap, w: bw, h: bh };

        roundRectPath(playAgainRect.x, playAgainRect.y, bw, bh, 12);
        const grad = ctx.createLinearGradient(0, playAgainRect.y, 0, playAgainRect.y + bh);
        grad.addColorStop(0, '#34d399');
        grad.addColorStop(1, '#059669');
        ctx.fillStyle = grad;
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 19px Inter, sans-serif';
        ctx.fillText('Play Again', cx, playAgainRect.y + bh / 2 + 1);

        roundRectPath(menuRect.x, menuRect.y, bw, bh, 12);
        ctx.strokeStyle = p.sub;
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = p.text;
        ctx.font = 'bold 17px Inter, sans-serif';
        ctx.fillText('Change Difficulty', cx, menuRect.y + bh / 2 + 1);

        ctx.restore();
      }

      function roundRectPath(x: number, y: number, w: number, h: number, r: number) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }

      // ---------- HUD ----------
      function updateHud() {
        scoreValue.textContent = String(score);
        roundValue.textContent = String(roundNumber);
        heartsValue.textContent = '❤️'.repeat(Math.max(0, lives)) + '🖤'.repeat(Math.max(0, 3 - lives));
        modeLabel.textContent = `${mode.charAt(0).toUpperCase() + mode.slice(1)} · Round`;
        if (streak >= 2) {
          streakBadge.style.display = '';
          streakBadge.textContent = `🔥 ${streak} round streak (+${CONFIG.STREAK_BONUS * streak} bonus)`;
        } else {
          streakBadge.style.display = 'none';
        }
      }

      function popScore() {
        scoreValue.classList.remove('pop');
        void scoreValue.offsetWidth;
        scoreValue.classList.add('pop');
      }

      function setHint(text: string) {
        phaseHint.textContent = text;
        phaseHint.classList.toggle('visible', !!text);
      }

      // ---------- Memorize bar ----------
      let barRaf: number | null = null;

      function runMemorizeBar(durationMs: number) {
        memorizeBarTrack.style.visibility = 'visible';
        const start = performance.now();
        const tick = () => {
          const remain = Math.max(0, 1 - (performance.now() - start) / durationMs);
          memorizeBar.style.transform = `scaleX(${remain})`;
          memorizeBar.classList.toggle('urgent', remain < 0.35);
          if (remain > 0 && phase === 'memorize') barRaf = requestAnimationFrame(tick);
        };
        tick();
      }

      function hideMemorizeBar() {
        if (barRaf !== null) { cancelAnimationFrame(barRaf); barRaf = null; }
        memorizeBarTrack.style.visibility = 'hidden';
      }

      // ---------- Game flow ----------
      function clearTimers() {
        while (timers.length) clearTimeout(timers.pop()!);
      }

      function after(ms: number, fn: () => void) {
        timers.push(window.setTimeout(fn, ms));
      }

      function startGame(selectedMode: string) {
        mode = selectedMode;
        score = 0;
        lives = 3;
        roundNumber = 1;
        streak = 0;
        newHighScore = false;
        currentDuration = CONFIG.INITIAL_DURATION[mode];

        splash.style.display = 'none';
        gameScreen.style.display = 'block';
        updateHud();

        requestAnimationFrame(() => {
          resizeCanvas();
          startLoop();
          startRound();
        });
      }

      function startRound() {
        clearTimers();
        hideMemorizeBar();
        currentIndex = 0;
        generateCircles(CONFIG.CIRCLE_COUNTS[mode]);
        // circles spawn during memorize; reset spawn to countdown end
        phase = 'countdown';
        countdownValue = 3;
        countdownStart = performance.now();
        setHint('Get ready…');
        sfx.beep();

        const step = () => {
          countdownValue--;
          countdownStart = performance.now();
          if (countdownValue > 0) {
            sfx.beep();
            after(950, step);
          } else {
            beginMemorize();
          }
        };
        after(950, step);
      }

      function beginMemorize() {
        phase = 'memorize';
        const now = performance.now();
        circles.forEach((c, i) => { c.spawnAt = now + i * 70; });
        sfx.go();
        setHint('Memorize the positions!');
        const totalMs = currentDuration * 1000 + circles.length * 70;
        runMemorizeBar(totalMs);
        after(totalMs, () => {
          if (phase !== 'memorize') return;
          phase = 'recall';
          hideMemorizeBar();
          setHint('Now tap them in order — start with 1');
        });
      }

      function handleCorrect(c: Circle) {
        c.clicked = true;
        c.clickedAt = performance.now();
        currentIndex++;
        score += CONFIG.POINTS_PER_CORRECT;
        sfx.correct(currentIndex);
        vibrate(12);
        popScore();
        updateHud();
        setHint(currentIndex < circles.length ? `Nice — next is ${currentIndex + 1}` : '');

        if (currentIndex === circles.length) {
          // round complete
          const bonus = CONFIG.ROUND_BONUS[mode] + streak * CONFIG.STREAK_BONUS;
          score += bonus;
          streak++;
          sfx.roundComplete();
          vibrate([20, 40, 20]);
          popScore();
          updateHud();
          setHint(`Round ${roundNumber} complete! +${bonus} bonus`);
          roundNumber++;
          currentDuration = Math.max(CONFIG.MIN_DURATION, currentDuration - CONFIG.DURATION_DECREMENT);
          phase = 'idle';
          after(1400, startRound);
        }
      }

      function handleWrong(c: Circle) {
        c.wrongAt = performance.now();
        lives--;
        streak = 0;
        sfx.wrong();
        vibrate([70, 40, 70]);
        updateHud();
        phase = 'reveal';
        revealStart = performance.now();
        setHint(lives > 0 ? `Ouch! The order is revealed — ${lives} ${lives === 1 ? 'life' : 'lives'} left` : '');

        if (lives <= 0) {
          after(2200, gameOver);
        } else {
          after(2200, startRound);
        }
      }

      function gameOver() {
        clearTimers();
        hideMemorizeBar();
        phase = 'gameover';
        gameOverAt = performance.now();
        setHint('');

        const hs = getHighScores();
        if (score > (hs[mode] ?? 0)) {
          hs[mode] = score;
          localStorage.setItem(HS_KEY, JSON.stringify(hs));
          newHighScore = true;
          sfx.highScore();
          vibrate([30, 50, 30, 50, 100]);
        } else {
          sfx.gameOver();
        }
        renderBests();
      }

      function backToMenu() {
        clearTimers();
        stopLoop();
        hideMemorizeBar();
        phase = 'idle';
        gameScreen.style.display = 'none';
        splash.style.display = 'block';
        renderBests();
      }

      // ---------- Input ----------
      canvas.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        // Scale from viewport coordinates to canvas CSS coordinates: the site
        // applies `zoom: 0.8` globally, which shrinks rect.* relative to clientWidth.
        const scaleX = cssW / rect.width;
        const scaleY = cssH / rect.height;
        const x = (e.clientX - rect.left) * scaleX;
        const y = (e.clientY - rect.top) * scaleY;

        if (phase === 'gameover') {
          if (inRect(x, y, playAgainRect)) { startGame(mode); return; }
          if (inRect(x, y, menuRect)) { backToMenu(); return; }
          return;
        }

        if (phase !== 'recall') return;

        // find nearest circle hit (generous touch target: r + 8)
        let hit: Circle | null = null;
        let hitDist = Infinity;
        for (const c of circles) {
          const d = Math.hypot(x - c.x, y - c.y);
          if (d <= c.r + 8 && d < hitDist) { hit = c; hitDist = d; }
        }
        if (!hit || hit.clicked) return;

        if (hit.number === currentIndex + 1) handleCorrect(hit);
        else handleWrong(hit);
      });

      canvas.addEventListener('touchmove', e => e.preventDefault(), { passive: false });
      canvas.addEventListener('contextmenu', e => e.preventDefault());

      function inRect(x: number, y: number, r: { x: number, y: number, w: number, h: number }) {
        return x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h;
      }

      $('quitBtn').addEventListener('click', backToMenu);

      // Mode selection
      document.querySelectorAll<HTMLButtonElement>('#modeButtons button').forEach(btn => {
        btn.addEventListener('click', () => startGame(btn.dataset.mode!));
      });

      // Keyboard: Enter/Space restarts on game over, Escape quits
      window.addEventListener('keydown', e => {
        if (gameScreen.style.display === 'none') return;
        if (e.code === 'Escape') { backToMenu(); }
        else if (phase === 'gameover' && (e.code === 'Enter' || e.code === 'Space')) {
          e.preventDefault();
          startGame(mode);
        }
      });

    })();
  </script>

