---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'Reaction Trainer';
const pageDescription = 'Test and improve your reaction time and decision-making speed';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="reaction-wrapper">
    <div class="container mx-auto px-4">
      <main class="reaction-container">
        <header class="app-header">
          <h1 class="page-title">Reaction &amp; Decision Trainer</h1>
          <div class="tab-buttons" role="tablist">
            <button class="tab-select active" id="play-tab-btn" role="tab" aria-selected="true">Play</button>
            <button class="tab-select" id="compare-tab-btn" role="tab" aria-selected="false">History &amp; Compare</button>
          </div>
        </header>

        <!-- ============ PLAY TAB ============ -->
        <div id="play-tab">
          <div class="mode-row">
            <div class="mode-toggle" id="mode-buttons">
              <button class="mode-btn active" data-mode="reaction">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                Reaction
              </button>
              <button class="mode-btn" data-mode="decision">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
                Decision
              </button>
            </div>
            <button id="info-btn" aria-label="How to play">?</button>
          </div>

          <div class="pb-row" id="pb-row"></div>

          <!-- Trial progress -->
          <div class="trial-dots" id="trial-dots" aria-hidden="true"></div>

          <!-- Arena -->
          <div id="arena" class="arena state-idle" tabindex="0" role="button" aria-label="Reaction test area">
            <div class="arena-divider" id="arena-divider"></div>
            <div class="arena-content">
              <div class="arena-icon" id="arena-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
              </div>
              <div class="arena-main" id="arena-main">Tap to start</div>
              <div class="arena-sub" id="arena-sub">or press Space</div>
            </div>
          </div>

          <!-- Stats -->
          <div class="stats-grid" id="stats-grid" style="display:none">
            <div class="stat-card"><span class="stat-label">Last</span><span class="stat-value" id="stat-last">—</span></div>
            <div class="stat-card"><span class="stat-label">Average</span><span class="stat-value" id="stat-avg">—</span></div>
            <div class="stat-card"><span class="stat-label">Best</span><span class="stat-value" id="stat-best">—</span></div>
            <div class="stat-card"><span class="stat-label">Consistency</span><span class="stat-value" id="stat-sd">—</span></div>
          </div>

          <div class="rating-banner" id="rating-banner" style="display:none"></div>

          <canvas id="chart" style="display:none"></canvas>

          <div class="session-actions" id="session-actions" style="display:none">
            <button id="save-session-trigger" class="btn-green">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
              Save Session
            </button>
            <button id="retry-btn" class="btn-purple">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              Go Again
            </button>
          </div>
        </div>

        <!-- ============ COMPARE TAB ============ -->
        <div id="compare-tab">
          <h2 class="compare-title">Session History</h2>
          <div class="compare-controls">
            <label for="compare-type">Mode</label>
            <select id="compare-type">
              <option value="reaction">Reaction</option>
              <option value="decision">Decision</option>
            </select>
          </div>
          <div id="session-table"></div>
          <div class="compare-controls compare-pickers" id="compare-pickers">
            <div class="picker">
              <label for="session1"><span class="dot dot-green"></span>Session A</label>
              <select id="session1"></select>
            </div>
            <div class="picker">
              <label for="session2"><span class="dot dot-blue"></span>Session B</label>
              <select id="session2"></select>
            </div>
          </div>
          <canvas id="compare-chart"></canvas>
          <div id="compare-stats"></div>
          <p id="no-sessions" class="no-sessions" style="display:none">No saved sessions yet. Play a round and save it to see it here.</p>
        </div>

        <!-- Save modal -->
        <div id="session-name-modal" class="modal">
          <div class="modal-content">
            <h2>Save Session</h2>
            <p>Enter a name for this session (optional):</p>
            <input type="text" id="session-name" placeholder="Your name" maxlength="30" />
            <div class="modal-buttons">
              <button id="save-session-btn" class="btn-green">Save</button>
              <button id="cancel-save-btn" class="btn-ghost">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Info modal -->
        <div id="info-modal" class="modal">
          <div class="modal-content">
            <h2>How to Play</h2>
            <p><strong>⚡ Reaction:</strong> Wait for the panel to turn <span class="text-green">green</span>, then tap it (or press <kbd>Space</kbd>) as fast as you can. Tapping early counts as a false start.</p>
            <p><strong>⇄ Decision:</strong> When the panel turns green it shows an arrow. Press the matching <kbd>←</kbd>/<kbd>→</kbd> arrow key, or <kbd>A</kbd>/<kbd>D</kbd>. On touch devices, tap the matching <b>left or right half</b> of the panel instead. Wrong side or early input = fail.</p>
            <p>Each round is 10 trials. Your average, best time, and consistency are tracked, and you can save sessions to compare progress over time.</p>
            <div class="rating-table">
              <div><span class="rt-time">&lt; 200 ms</span><span>Exceptional</span></div>
              <div><span class="rt-time">200–250 ms</span><span>Excellent</span></div>
              <div><span class="rt-time">250–300 ms</span><span>Good</span></div>
              <div><span class="rt-time">300–375 ms</span><span>Average</span></div>
              <div><span class="rt-time">&gt; 375 ms</span><span>Keep practicing!</span></div>
            </div>
            <button id="close-info" class="btn-purple">Got it!</button>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    (() => {
      const $ = (id: string) => document.getElementById(id)!;

      const arena = $('arena');
      const arenaMain = $('arena-main');
      const arenaSub = $('arena-sub');
      const arenaIcon = $('arena-icon');
      const arenaDivider = $('arena-divider');
      const trialDots = $('trial-dots');
      const statsGrid = $('stats-grid');
      const ratingBanner = $('rating-banner');
      const chartCanvas = $('chart') as HTMLCanvasElement;
      const chartCtx = chartCanvas.getContext('2d')!;
      const sessionActions = $('session-actions');
      const pbRow = $('pb-row');

      const MAX_TRIALS = 10;
      type Trial = { time: number; fail: boolean; direction?: string };

      type Phase = 'idle' | 'waiting' | 'go' | 'between' | 'done';
      let phase: Phase = 'idle';
      let currentMode: 'reaction' | 'decision' = 'reaction';
      let expectDirection: 'left' | 'right' = 'left';
      let startTime = 0;
      let session: Trial[] = [];
      let goTimer: number | null = null;
      let betweenTimer: number | null = null;

      const SESSIONS_KEY = 'reactionSessions';
      const PB_KEY = 'reactionPersonalBests';

      const vibrate = (pattern: number | number[]) => {
        if ('vibrate' in navigator) { try { navigator.vibrate(pattern); } catch { /* unsupported */ } }
      };

      // Primary input is touch (phone/tablet) vs keyboard+mouse (desktop)
      const touchPrimary = window.matchMedia('(pointer: coarse)').matches;
      const decisionHint = touchPrimary ? 'tap the side matching the arrow' : 'use ← / → or A / D keys';

      // ---------- Personal bests ----------
      function getPBs(): Record<string, number> {
        try { return JSON.parse(localStorage.getItem(PB_KEY) || '{}'); } catch { return {}; }
      }

      function renderPB() {
        const pbs = getPBs();
        const pb = pbs[currentMode];
        pbRow.innerHTML = pb
          ? `🏆 Personal best (${currentMode}): <strong>${pb.toFixed(0)} ms</strong>`
          : `No personal best yet — play a round!`;
      }

      function maybeUpdatePB(avg: number): boolean {
        const pbs = getPBs();
        if (!pbs[currentMode] || avg < pbs[currentMode]) {
          pbs[currentMode] = avg;
          localStorage.setItem(PB_KEY, JSON.stringify(pbs));
          return true;
        }
        return false;
      }

      // ---------- Trial dots ----------
      function renderDots() {
        trialDots.innerHTML = '';
        for (let i = 0; i < MAX_TRIALS; i++) {
          const dot = document.createElement('span');
          dot.className = 'dot-trial';
          if (i < session.length) dot.classList.add(session[i].fail ? 'fail' : 'ok');
          else if (i === session.length && phase !== 'idle' && phase !== 'done') dot.classList.add('current');
          trialDots.appendChild(dot);
        }
      }

      // ---------- Arena state ----------
      function setArena(state: 'idle' | 'waiting' | 'go' | 'fail' | 'success' | 'done', main: string, sub: string, icon?: string) {
        arena.className = `arena state-${state}`;
        arenaMain.textContent = main;
        arenaSub.textContent = sub;
        if (icon !== undefined) {
          arenaIcon.style.display = icon ? '' : 'none';
          if (icon) arenaIcon.innerHTML = icon;
        }
        arenaDivider.style.display = (touchPrimary && currentMode === 'decision' && (state === 'waiting' || state === 'go')) ? '' : 'none';
      }

      const BOLT_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>`;

      // ---------- Game flow ----------
      function startSession() {
        session = [];
        phase = 'waiting';
        statsGrid.style.display = 'none';
        ratingBanner.style.display = 'none';
        chartCanvas.style.display = 'none';
        sessionActions.style.display = 'none';
        scheduleGo();
        renderDots();
      }

      function scheduleGo() {
        setArena('waiting', 'Wait for green…',
          currentMode === 'decision'
            ? (touchPrimary ? 'then tap the side the arrow points to' : 'then press ← / → or A / D')
            : 'then tap as fast as you can', '');
        const delay = 1200 + Math.random() * 2300;
        if (goTimer !== null) clearTimeout(goTimer);
        goTimer = window.setTimeout(() => {
          if (phase !== 'waiting') return;
          phase = 'go';
          if (currentMode === 'decision') {
            expectDirection = Math.random() > 0.5 ? 'left' : 'right';
            setArena('go', expectDirection === 'left' ? '←' : '→',
              touchPrimary ? 'Tap the matching side!' : 'Press the matching key!', '');
          } else {
            setArena('go', 'TAP!', '', '');
          }
          startTime = performance.now();
        }, delay);
      }

      function recordTrial(trial: Trial, message: string, subMessage: string) {
        session.push(trial);
        renderDots();
        phase = 'between';
        if (trial.fail) {
          vibrate([60, 40, 60]);
          setArena('fail', message, subMessage, '');
        } else {
          vibrate(15);
          setArena('success', message, subMessage, '');
        }
        if (betweenTimer !== null) clearTimeout(betweenTimer);
        betweenTimer = window.setTimeout(() => {
          if (session.length >= MAX_TRIALS) endSession();
          else { phase = 'waiting'; scheduleGo(); renderDots(); }
        }, 1100);
      }

      function handleInput(direction: 'left' | 'right' | 'any') {
        if (phase === 'idle' || phase === 'done') {
          startSession();
          return;
        }
        if (phase === 'between') return;
        if (phase === 'waiting') {
          if (goTimer !== null) clearTimeout(goTimer);
          recordTrial({ time: 0, fail: true }, 'Too soon!', 'Wait for green next time');
          return;
        }
        if (phase === 'go') {
          const time = performance.now() - startTime;
          if (currentMode === 'reaction') {
            recordTrial({ time, fail: false }, `${time.toFixed(0)} ms`, quickRating(time));
          } else {
            if (direction === expectDirection || direction === 'any') {
              // 'any' (space) is not valid in decision mode
              if (direction === 'any') {
                recordTrial({ time: 0, fail: true }, touchPrimary ? 'Tap a side!' : 'Use ← / → or A / D!', '');
              } else {
                recordTrial({ time, fail: false, direction }, `${time.toFixed(0)} ms`, quickRating(time));
              }
            } else {
              recordTrial({ time: 0, fail: true }, 'Wrong side!', `It was ${expectDirection === 'left' ? '←' : '→'}`);
            }
          }
        }
      }

      function quickRating(t: number): string {
        if (t < 200) return 'Exceptional!';
        if (t < 250) return 'Excellent';
        if (t < 300) return 'Good';
        if (t < 375) return 'Average';
        return 'Keep practicing';
      }

      function calcStats(sess: Trial[]) {
        const valid = sess.filter(s => !s.fail);
        if (!valid.length) return { avg: 0, sd: 0, best: 0, count: 0 };
        const mean = valid.reduce((a, b) => a + b.time, 0) / valid.length;
        const sd = Math.sqrt(valid.reduce((a, b) => a + (b.time - mean) ** 2, 0) / valid.length);
        const best = Math.min(...valid.map(v => v.time));
        return { avg: mean, sd, best, count: valid.length };
      }

      function endSession() {
        phase = 'done';
        const { avg, sd, best, count } = calcStats(session);
        renderDots();

        setArena('done', 'Round complete!', 'Tap to play again', BOLT_ICON);

        if (count > 0) {
          $('stat-last').textContent = `${(session.filter(s => !s.fail).pop()?.time ?? 0).toFixed(0)} ms`;
          $('stat-avg').textContent = `${avg.toFixed(0)} ms`;
          $('stat-best').textContent = `${best.toFixed(0)} ms`;
          $('stat-sd').textContent = `±${sd.toFixed(0)} ms`;
          statsGrid.style.display = '';

          const isPB = maybeUpdatePB(avg);
          renderPB();
          ratingBanner.style.display = '';
          ratingBanner.textContent = isPB
            ? `🏆 New personal best! Average ${avg.toFixed(0)} ms — ${quickRating(avg)}`
            : `${quickRating(avg)} — average ${avg.toFixed(0)} ms over ${count}/${MAX_TRIALS} valid trials`;
          if (isPB) vibrate([30, 50, 30, 50, 80]);

          chartCanvas.style.display = '';
          drawSessionChart();
        } else {
          ratingBanner.style.display = '';
          ratingBanner.textContent = 'No valid trials — wait for green before tapping!';
        }
        sessionActions.style.display = '';
        $('save-session-trigger').style.display = count > 0 ? '' : 'none';
      }

      // ---------- Charts (HiDPI aware) ----------
      function setupCanvas(canvas: HTMLCanvasElement, cssH: number): { W: number, H: number, ctx: CanvasRenderingContext2D } {
        const dpr = window.devicePixelRatio || 1;
        const cssW = canvas.clientWidth || canvas.parentElement!.clientWidth;
        canvas.style.height = `${cssH}px`;
        canvas.width = Math.round(cssW * dpr);
        canvas.height = Math.round(cssH * dpr);
        const ctx = canvas.getContext('2d')!;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        return { W: cssW, H: cssH, ctx };
      }

      function isDark() { return document.documentElement.classList.contains('dark'); }

      function chartColors() {
        return isDark()
          ? { grid: 'rgba(255,255,255,0.08)', text: '#9ca3af', axis: 'rgba(255,255,255,0.2)', avg: '#c084fc' }
          : { grid: 'rgba(0,0,0,0.06)', text: '#7f8c8d', axis: 'rgba(0,0,0,0.15)', avg: '#764ba2' };
      }

      function drawSeries(ctx: CanvasRenderingContext2D, sess: Trial[], W: number, H: number, pad: {l:number,r:number,t:number,b:number}, maxMs: number, color: string) {
        const pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
        const xFor = (i: number) => pad.l + (sess.length === 1 ? pw / 2 : (i / (sess.length - 1)) * pw);
        const yFor = (ms: number) => pad.t + ph - (Math.min(ms, maxMs) / maxMs) * ph;

        // line through valid points
        ctx.strokeStyle = color;
        ctx.lineWidth = 2.5;
        ctx.lineJoin = 'round';
        ctx.beginPath();
        let started = false;
        sess.forEach((t, i) => {
          if (t.fail) return;
          const x = xFor(i), y = yFor(t.time);
          if (!started) { ctx.moveTo(x, y); started = true; } else ctx.lineTo(x, y);
        });
        ctx.stroke();

        // points
        sess.forEach((t, i) => {
          const x = xFor(i);
          if (t.fail) {
            ctx.fillStyle = '#ef4444';
            ctx.beginPath();
            const y = pad.t + ph;
            ctx.moveTo(x - 5, y - 5); ctx.lineTo(x + 5, y + 5);
            ctx.moveTo(x + 5, y - 5); ctx.lineTo(x - 5, y + 5);
            ctx.strokeStyle = '#ef4444';
            ctx.lineWidth = 2.5;
            ctx.stroke();
          } else {
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(x, yFor(t.time), 4.5, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      }

      function drawFrame(ctx: CanvasRenderingContext2D, W: number, H: number, pad: {l:number,r:number,t:number,b:number}, maxMs: number) {
        const col = chartColors();
        const pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
        ctx.clearRect(0, 0, W, H);
        ctx.font = '11px Inter, sans-serif';
        ctx.fillStyle = col.text;
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        const steps = 4;
        for (let s = 0; s <= steps; s++) {
          const ms = (maxMs / steps) * s;
          const y = pad.t + ph - (ms / maxMs) * ph;
          ctx.strokeStyle = s === 0 ? col.axis : col.grid;
          ctx.beginPath();
          ctx.moveTo(pad.l, y);
          ctx.lineTo(pad.l + pw, y);
          ctx.stroke();
          ctx.fillText(`${ms.toFixed(0)}`, pad.l - 6, y);
        }
      }

      function drawSessionChart() {
        const { W, H, ctx } = setupCanvas(chartCanvas, 190);
        const pad = { l: 40, r: 12, t: 12, b: 20 };
        const validTimes = session.filter(s => !s.fail).map(s => s.time);
        const maxMs = Math.max(400, Math.ceil((Math.max(...validTimes, 300) * 1.15) / 100) * 100);
        drawFrame(ctx, W, H, pad, maxMs);

        // average line
        const { avg } = calcStats(session);
        if (avg > 0) {
          const col = chartColors();
          const ph = H - pad.t - pad.b;
          const y = pad.t + ph - (Math.min(avg, maxMs) / maxMs) * ph;
          ctx.strokeStyle = col.avg;
          ctx.setLineDash([5, 4]);
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(pad.l, y);
          ctx.lineTo(W - pad.r, y);
          ctx.stroke();
          ctx.setLineDash([]);
        }

        drawSeries(ctx, session, W, H, pad, maxMs, '#10b981');

        // x labels
        const col = chartColors();
        ctx.fillStyle = col.text;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillText('trial 1', pad.l + 14, H - pad.b + 6);
        ctx.fillText(`trial ${session.length}`, W - pad.r - 16, H - pad.b + 6);
      }

      // ---------- Input wiring ----------
      arena.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        if (phase === 'idle' || phase === 'done') {
          // any pointer can start a session
          handleInput('any');
          return;
        }
        if (currentMode === 'decision') {
          // Mid-round decision input: touch/pen taps pick a side; mouse clicks
          // are ignored — keyboard (← / → or A / D) is the desktop input.
          if (e.pointerType === 'mouse') return;
          const rect = arena.getBoundingClientRect();
          handleInput(e.clientX - rect.left < rect.width / 2 ? 'left' : 'right');
        } else {
          handleInput('any');
        }
      });

      arena.addEventListener('contextmenu', e => e.preventDefault());

      window.addEventListener('keydown', e => {
        const t = e.target as HTMLElement;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'SELECT' || t.tagName === 'TEXTAREA')) return;
        if ($('play-tab').style.display === 'none') return;
        if (e.code === 'Space') {
          e.preventDefault();
          if (currentMode === 'reaction' || phase === 'idle' || phase === 'done') handleInput('any');
        } else if (currentMode === 'decision') {
          if (e.code === 'ArrowLeft' || e.code === 'KeyA') { e.preventDefault(); handleInput('left'); }
          else if (e.code === 'ArrowRight' || e.code === 'KeyD') { e.preventDefault(); handleInput('right'); }
        }
      });

      // ---------- Mode switching ----------
      const modeButtons = document.querySelectorAll<HTMLButtonElement>('.mode-btn');
      modeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.dataset.mode === currentMode) return;
          modeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentMode = btn.dataset.mode as 'reaction' | 'decision';
          resetToIdle();
          renderPB();
        });
      });

      function resetToIdle() {
        phase = 'idle';
        session = [];
        if (goTimer !== null) clearTimeout(goTimer);
        if (betweenTimer !== null) clearTimeout(betweenTimer);
        statsGrid.style.display = 'none';
        ratingBanner.style.display = 'none';
        chartCanvas.style.display = 'none';
        sessionActions.style.display = 'none';
        setArena('idle', 'Tap to start',
          currentMode === 'decision' ? decisionHint : 'or press Space', BOLT_ICON);
        renderDots();
      }

      $('retry-btn').addEventListener('click', () => startSession());

      // ---------- Save session ----------
      const modal = $('session-name-modal');
      const sessionInput = $('session-name') as HTMLInputElement;

      $('save-session-trigger').addEventListener('click', () => {
        modal.style.display = 'flex';
        sessionInput.value = '';
        setTimeout(() => sessionInput.focus(), 50);
      });
      $('cancel-save-btn').addEventListener('click', () => { modal.style.display = 'none'; });
      modal.addEventListener('click', e => { if (e.target === modal) modal.style.display = 'none'; });
      sessionInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') doSave();
        if (e.key === 'Escape') modal.style.display = 'none';
      });
      $('save-session-btn').addEventListener('click', doSave);

      function getSessions(): any[] {
        try { return JSON.parse(localStorage.getItem(SESSIONS_KEY) || '[]'); } catch { return []; }
      }

      function doSave() {
        const name = sessionInput.value.trim() || 'Anonymous';
        const data = getSessions();
        data.push({ name, mode: currentMode, date: new Date().toISOString(), session });
        localStorage.setItem(SESSIONS_KEY, JSON.stringify(data));
        modal.style.display = 'none';
        $('save-session-trigger').style.display = 'none';
        ratingBanner.textContent = `💾 Session saved as "${name}"`;
        populateCompareUI();
      }

      // ---------- Info modal ----------
      const infoModal = $('info-modal');
      $('info-btn').addEventListener('click', () => { infoModal.style.display = 'flex'; });
      $('close-info').addEventListener('click', () => { infoModal.style.display = 'none'; });
      infoModal.addEventListener('click', e => { if (e.target === infoModal) infoModal.style.display = 'none'; });

      // ---------- Tabs ----------
      const playTab = $('play-tab'), compareTab = $('compare-tab');
      const playTabBtn = $('play-tab-btn'), compareTabBtn = $('compare-tab-btn');

      playTabBtn.addEventListener('click', () => switchTab(true));
      compareTabBtn.addEventListener('click', () => switchTab(false));

      function switchTab(toPlay: boolean) {
        playTab.style.display = toPlay ? 'block' : 'none';
        compareTab.style.display = toPlay ? 'none' : 'block';
        playTabBtn.classList.toggle('active', toPlay);
        compareTabBtn.classList.toggle('active', !toPlay);
        playTabBtn.setAttribute('aria-selected', String(toPlay));
        compareTabBtn.setAttribute('aria-selected', String(!toPlay));
        if (!toPlay) populateCompareUI();
        else if (phase === 'idle') resetToIdle();
      }

      // ---------- Compare tab ----------
      const compareType = $('compare-type') as HTMLSelectElement;
      const session1Select = $('session1') as HTMLSelectElement;
      const session2Select = $('session2') as HTMLSelectElement;
      const compareChartEl = $('compare-chart') as HTMLCanvasElement;
      const compareStats = $('compare-stats');
      const sessionTable = $('session-table');
      const noSessions = $('no-sessions');

      compareType.addEventListener('change', populateCompareUI);
      session1Select.addEventListener('change', drawCompare);
      session2Select.addEventListener('change', drawCompare);

      function populateCompareUI() {
        const data = getSessions();
        const filtered = data
          .map((s: any, i: number) => ({ ...s, _idx: i }))
          .filter((s: any) => s.mode === compareType.value);

        const hasAny = filtered.length > 0;
        noSessions.style.display = hasAny ? 'none' : '';
        $('compare-pickers').style.display = hasAny ? '' : 'none';
        compareChartEl.style.display = hasAny ? '' : 'none';
        compareStats.style.display = hasAny ? '' : 'none';
        sessionTable.innerHTML = '';
        if (!hasAny) return;

        // session list with stats + delete
        filtered.slice().reverse().forEach((s: any) => {
          const { avg, sd, count } = calcStats(s.session);
          const row = document.createElement('div');
          row.className = 'session-row';
          row.innerHTML = `
            <div class="session-info">
              <span class="session-name">${escapeHtml(s.name)}</span>
              <span class="session-date">${new Date(s.date).toLocaleString()}</span>
            </div>
            <div class="session-metrics">
              <span><b>${avg.toFixed(0)}</b> ms avg</span>
              <span>±${sd.toFixed(0)}</span>
              <span>${count}/${s.session.length} ok</span>
            </div>`;
          const del = document.createElement('button');
          del.className = 'session-delete';
          del.setAttribute('aria-label', 'Delete session');
          del.textContent = '×';
          del.addEventListener('click', () => {
            const all = getSessions();
            all.splice(s._idx, 1);
            localStorage.setItem(SESSIONS_KEY, JSON.stringify(all));
            populateCompareUI();
          });
          row.appendChild(del);
          sessionTable.appendChild(row);
        });

        [session1Select, session2Select].forEach((sel, si) => {
          sel.innerHTML = '';
          filtered.forEach((s: any) => {
            const opt = document.createElement('option');
            opt.value = String(s._idx);
            opt.textContent = `${s.name} — ${new Date(s.date).toLocaleDateString()} ${new Date(s.date).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}`;
            sel.appendChild(opt);
          });
          const pick = Math.max(0, filtered.length - 1 - si);
          if (filtered[pick]) sel.value = String(filtered[pick]._idx);
        });

        drawCompare();
      }

      function drawCompare() {
        const data = getSessions();
        const s1 = data[parseInt(session1Select.value)];
        const s2 = data[parseInt(session2Select.value)];
        if (!s1 || !s2) return;

        const { W, H, ctx } = setupCanvas(compareChartEl, 220);
        const pad = { l: 40, r: 12, t: 12, b: 20 };
        const allTimes = [...s1.session, ...s2.session].filter((t: Trial) => !t.fail).map((t: Trial) => t.time);
        const maxMs = Math.max(400, Math.ceil((Math.max(...allTimes, 300) * 1.15) / 100) * 100);
        drawFrame(ctx, W, H, pad, maxMs);
        drawSeries(ctx, s1.session, W, H, pad, maxMs, '#10b981');
        drawSeries(ctx, s2.session, W, H, pad, maxMs, '#3b82f6');

        const st1 = calcStats(s1.session), st2 = calcStats(s2.session);
        const diff = st1.avg && st2.avg ? st2.avg - st1.avg : 0;
        const diffText = !st1.avg || !st2.avg ? '' :
          diff < 0 ? ` — B is ${Math.abs(diff).toFixed(0)} ms faster` :
          diff > 0 ? ` — A is ${diff.toFixed(0)} ms faster` : ' — dead even!';
        compareStats.innerHTML =
          `<span class="cmp-a">${escapeHtml(s1.name)}: <b>${st1.avg.toFixed(0)} ms</b> (±${st1.sd.toFixed(0)})</span>` +
          `<span class="cmp-b">${escapeHtml(s2.name)}: <b>${st2.avg.toFixed(0)} ms</b> (±${st2.sd.toFixed(0)})</span>` +
          `<span class="cmp-diff">${diffText}</span>`;
      }

      function escapeHtml(s: string) {
        return s.replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]!));
      }

      // redraw charts on resize
      let resizeTimer: number | null = null;
      window.addEventListener('resize', () => {
        if (resizeTimer !== null) clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          if (chartCanvas.style.display !== 'none' && session.length) drawSessionChart();
          if (compareTab.style.display !== 'none') drawCompare();
        }, 150);
      });

      // init
      resetToIdle();
      renderPB();
    })();
  </script>

