---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'Hash Generator';
const pageDescription = 'SHA-256, SHA-384, and SHA-512 hashes in the browser via Web Crypto.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="tool-wrap">
    <div class="container mx-auto px-4 max-w-3xl">
      <header class="tool-head">
        <p class="tool-kicker">Developer tools</p>
        <h1>Hash generator</h1>
        <p>SHA-2 digests with the Web Crypto API. Text is hashed as UTF-8. Nothing is uploaded.</p>
      </header>

      <div class="tool-card">
        <label class="label" for="input">Input</label>
        <textarea id="input" class="field mono" rows="8" placeholder="Paste text…"></textarea>
        <div class="algo-row">
          <label><input type="radio" name="algo" value="SHA-256" checked /> SHA-256</label>
          <label><input type="radio" name="algo" value="SHA-384" /> SHA-384</label>
          <label><input type="radio" name="algo" value="SHA-512" /> SHA-512</label>
        </div>
        <div class="out">
          <div>
            <span class="label">Hex</span>
            <code id="hex-out" class="mono block">—</code>
          </div>
          <div>
            <span class="label">Base64</span>
            <code id="b64-out" class="mono block">—</code>
          </div>
        </div>
        <div class="actions">
          <button type="button" id="copy-hex" class="btn-secondary">Copy hex</button>
          <button type="button" id="copy-b64" class="btn-secondary">Copy base64</button>
          <span id="status" class="status"></span>
        </div>
      </div>
    </div>
  </div>

  <script>
    const input = document.getElementById('input') as HTMLTextAreaElement;
    const hexOut = document.getElementById('hex-out')!;
    const b64Out = document.getElementById('b64-out')!;
    const status = document.getElementById('status')!;

    function toHex(buf: ArrayBuffer) {
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    function toB64(buf: ArrayBuffer) {
      return btoa(String.fromCharCode(...new Uint8Array(buf)));
    }

    async function hash() {
      const algo = (document.querySelector('input[name="algo"]:checked') as HTMLInputElement).value;
      const data = new TextEncoder().encode(input.value);
      const digest = await crypto.subtle.digest(algo, data);
      hexOut.textContent = toHex(digest);
      b64Out.textContent = toB64(digest);
    }

    async function copy(text: string, label: string) {
      await navigator.clipboard.writeText(text);
      status.textContent = `${label} copied`;
      setTimeout(() => { status.textContent = ''; }, 1500);
    }

    input.addEventListener('input', hash);
    document.querySelectorAll('input[name="algo"]').forEach((el) => el.addEventListener('change', hash));
    document.getElementById('copy-hex')?.addEventListener('click', () => copy(hexOut.textContent || '', 'Hex'));
    document.getElementById('copy-b64')?.addEventListener('click', () => copy(b64Out.textContent || '', 'Base64'));
    hash();
  </script>

  <style>
    .tool-wrap { padding-top: 8rem; padding-bottom: 4rem; min-height: 100vh; background: #f8fafc; }
    :global(.dark) .tool-wrap { background: rgb(3, 7, 18); }
    .tool-kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #2563eb; margin-bottom: 6px; }
    .tool-head { margin-bottom: 1.5rem; }
    .tool-head h1 { font-size: 2rem; font-weight: 800; margin-bottom: 6px; }
    .tool-head p { color: #6b7280; }
    .tool-card { background: white; border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.25rem 1.5rem; }
    :global(.dark) .tool-card { background: rgb(17, 24, 39); border-color: rgb(31, 41, 55); }
    .label { display: block; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #9ca3af; margin-bottom: 6px; }
    .field { width: 100%; border: 1px solid #e5e7eb; border-radius: 10px; padding: 10px 12px; background: #f8fafc; }
    :global(.dark) .field { background: rgb(31, 41, 55); border-color: rgb(55, 65, 81); color: #f3f4f6; }
    .mono { font-family: ui-monospace, Menlo, monospace; font-size: 0.85rem; overflow-wrap: anywhere; }
    .algo-row { display: flex; gap: 16px; margin: 12px 0; font-size: 14px; }
    .out { display: grid; gap: 12px; }
    .block { display: block; padding: 8px 0; }
    .btn-secondary { border: none; border-radius: 10px; padding: 8px 12px; font-weight: 700; cursor: pointer; background: #e5e7eb; margin-right: 8px; margin-top: 12px; }
    :global(.dark) .btn-secondary { background: rgb(55, 65, 81); color: #f3f4f6; }
    .status { font-size: 13px; color: #059669; }
  </style>
</Layout>
