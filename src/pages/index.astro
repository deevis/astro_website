---
import Layout from '../layouts/Layout.astro';
import HomeSlider from '../components/home/HomeSlider.astro';
import GalleryAccent from '../components/home/GalleryAccent.astro';
import HomeJumpNav from '../components/home/HomeJumpNav.astro';
import { showcases } from '../config/showcases.json';
import { mediaItems } from '../config/media.json';
import { apps, bitcoinResources } from '../config/catalog';
import { homeGameSlides, playgroundHref, cardAsset, homepageShowcases, interactiveArticles, type ShowcaseItem } from '../lib/showcases';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const writingItems = [
  ...articles.map((article) => ({
    href: `/articles/${article.slug}`,
    title: article.data.title,
    description: article.data.description,
    publishDate: article.data.publishDate,
    interactive: false,
  })),
  ...interactiveArticles(showcases as ShowcaseItem[]).map((item) => ({
    href: playgroundHref(item.href),
    title: item.title.replace(/:.*$/, ''),
    description: item.description,
    publishDate: item.publishDate ?? '1970-01-01',
    interactive: true,
  })),
]
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .slice(0, 3);

const galleryPool = mediaItems;

const gameSlides = homeGameSlides(showcases as ShowcaseItem[]);

const playgroundSlides = homepageShowcases(showcases as ShowcaseItem[])
  .filter((item) => item.category !== 'game')
  .map((item) => ({
    title: item.title.replace(/:.*$/, ''),
    tagline: item.description,
    href: playgroundHref(item.href),
    image: cardAsset(item.image),
  }));

const appSlides = apps.map((app) => ({
  title: app.title,
  tagline: app.tagline,
  href: app.href,
  image: cardAsset(app.image),
}));

const bitcoinSlides = bitcoinResources.map((item) => ({
  title: item.title,
  tagline: item.tagline,
  href: item.href,
}));
---

<Layout title="Darren Hicks" description="Personal workshop of games, simulations, Bitcoin tools, and writing from a software architect who learns by building.">
  <main class="pt-24 pb-12">
    <section class="pt-8 md:pt-16 pb-8 bg-gradient-to-br from-primary-50 to-white dark:from-dark-950 dark:to-dark-900">
      <div class="container mx-auto px-4 md:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">
            I build things that are interesting
            <small class="text-sm text-gray-500 dark:text-gray-400">(to me...)</small>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300">
            Games, simulations, apps, developer tools - hope you find something you like.
          </p>
        </div>
      </div>
    </section>

    <HomeJumpNav />

    <div class="container mx-auto px-4 md:px-6 lg:px-8 min-w-0 overflow-x-hidden">
      <HomeSlider
        sectionId="games"
        title="Games"
        blurb="Playable things. Today’s pick starts at the left — scroll for the rest."
        moreHref="/games"
        moreLabel="All games →"
        items={gameSlides}
        salt={0}
        variant="poster"
        eagerCount={4}
      />

      <div class="border-t border-gray-100 dark:border-dark-700">
        <HomeSlider
          sectionId="playground"
          title="Playground"
          blurb="Experiments, simulations, and visual toys."
          moreHref="/playground"
          moreLabel="Browse everything →"
          items={playgroundSlides}
          salt={1}
          variant="poster"
        />
      </div>

      <div class="border-t border-gray-100 dark:border-dark-700">
        <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(16rem,18rem)] gap-6 items-start min-w-0">
          <HomeSlider
            sectionId="apps"
            title="Applications"
            blurb="Utilities that live in the browser."
            items={appSlides}
            salt={3}
            variant="poster"
          />
          <div class="pt-10 min-w-0">
            <GalleryAccent items={galleryPool} caption="From the gallery" />
          </div>
        </div>
      </div>

      <div class="border-t border-gray-100 dark:border-dark-700">
        <HomeSlider
          sectionId="bitcoin"
          title="Bitcoin workshop"
          blurb="Tutorials, historical calculators, wallet comparisons, and on-chain explorers."
          moreHref="/bitcoin-resources"
          moreLabel="Resource library →"
          items={bitcoinSlides}
          salt={7}
          variant="compact"
        />
      </div>

      <section id="articles" class="py-12 scroll-mt-28 border-t border-gray-100 dark:border-dark-700">
        <div class="grid lg:grid-cols-[minmax(0,1.7fr)_minmax(16rem,0.8fr)] gap-6 items-start">
          <div>
            <div class="flex items-end justify-between mb-5">
              <h2 class="text-2xl md:text-3xl font-bold">Latest articles</h2>
              <a href="/articles" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">All articles →</a>
            </div>
            <div class="divide-y divide-gray-100 dark:divide-dark-700 border border-gray-200 dark:border-dark-700 rounded-2xl bg-white dark:bg-dark-800 overflow-hidden">
              {writingItems.map((item) => (
                <a href={item.href} class="block p-5 hover:bg-gray-50 dark:hover:bg-dark-900 transition-colors">
                  <div class="flex items-center gap-2">
                    <time class="text-xs text-gray-400" datetime={item.publishDate}>
                      {new Date(item.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                    </time>
                    {item.interactive && (
                      <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-primary-600 dark:text-primary-400">Interactive</span>
                    )}
                  </div>
                  <h3 class="font-semibold text-gray-900 dark:text-white mt-1">{item.title}</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">{item.description}</p>
                </a>
              ))}
            </div>
          </div>
          <GalleryAccent items={galleryPool} caption="Another from the gallery" />
        </div>
      </section>
    </div>
  </main>
</Layout>
