---
import ThemeToggle from './ThemeToggle.astro';
import TickerToggle from './TickerToggle.astro';
import { apps, bitcoinResources, developerTools } from '../config/catalog';
import { showcases } from '../config/showcases.json';
import { homeGameSlides, type ShowcaseItem } from '../lib/showcases';

interface NavLink {
  href: string;
  text: string;
}

interface NavDropdown {
  type: 'dropdown';
  id: string;
  label: string;
  items: NavLink[];
}

interface NavPlain {
  type: 'link';
  href: string;
  text: string;
}

type NavItem = NavDropdown | NavPlain;

const gameLinks: NavLink[] = homeGameSlides(showcases as ShowcaseItem[]).map((game) => ({
  href: game.href,
  text: game.title,
}));

const navItems: NavItem[] = [
  { type: 'dropdown', id: 'games', label: 'Games', items: gameLinks },
  { type: 'link', href: '/playground', text: 'Playground' },
  { type: 'dropdown', id: 'apps', label: 'Apps', items: apps.map((item) => ({ href: item.href, text: item.title })) },
  { type: 'dropdown', id: 'devtools', label: 'Developer Tools', items: developerTools.map((item) => ({ href: item.href, text: item.title })) },
  { type: 'link', href: '/news', text: 'News' },
  { type: 'dropdown', id: 'bitcoin', label: 'Bitcoin', items: bitcoinResources.map((item) => ({ href: item.href, text: item.title })) },
  { type: 'link', href: '/gallery', text: 'Gallery' },
  { type: 'link', href: '/about', text: 'About Me' },
];

const linkClass = 'text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors';
const dropItemClass = 'block px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-primary-600 dark:hover:text-primary-400 transition-colors first:rounded-t-lg last:rounded-b-lg';
const mobileLinkClass = 'block py-2 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors';
const mobileSubLinkClass = 'block py-2 text-gray-500 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors';
---

<header class="fixed w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-md shadow-sm z-50">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-2xl font-bold text-primary-600 dark:text-primary-400">darrenhicks.dev</a>
      
      <div class="hidden md:flex items-center space-x-5 lg:space-x-7">
        {navItems.map((item) => (
          item.type === 'link' ? (
            <a href={item.href} class={linkClass}>
              {item.text}
            </a>
          ) : (
            <div class="relative group">
              <button class={`flex items-center ${linkClass}`}>
                {item.label}
                <svg class="w-4 h-4 ml-1 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="absolute left-0 mt-2 w-56 max-h-[70vh] overflow-y-auto bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0">
                {item.items.map((entry) => (
                  <a href={entry.href} class={dropItemClass}>
                    {entry.text}
                  </a>
                ))}
              </div>
            </div>
          )
        ))}
      </div>

      <div class="flex items-center gap-1">
        <TickerToggle />
        <ThemeToggle />
        <button
          id="mobile-menu-button"
          class="md:hidden p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer touch-manipulation"
          type="button"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
        >
          <svg
            class="w-6 h-6 pointer-events-none"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden mt-4 space-y-4"
    >
      {navItems.map((item) => (
        item.type === 'link' ? (
          <a href={item.href} class={mobileLinkClass}>
            {item.text}
          </a>
        ) : (
          <div class="space-y-2">
            <button
              id={`mobile-${item.id}-toggle`}
              class="flex items-center justify-between w-full py-3 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors cursor-pointer touch-manipulation"
              type="button"
              aria-label={`Toggle ${item.label} menu`}
              aria-expanded="false"
              data-mobile-dropdown={item.id}
            >
              {item.label}
              <svg id={`mobile-${item.id}-arrow`} class="w-4 h-4 transition-transform pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div id={`mobile-${item.id}-menu`} class="hidden pl-4 space-y-2">
              {item.items.map((entry) => (
                <a href={entry.href} class={mobileSubLinkClass}>
                  {entry.text}
                </a>
              ))}
            </div>
          </div>
        )
      ))}
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    function toggleMobileMenu(e) {
      e.preventDefault();
      e.stopPropagation();
      if (menu) {
        const isHidden = menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        if (button) {
          button.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
        }
      }
    }

    function bindDropdown(id) {
      const toggle = document.getElementById(`mobile-${id}-toggle`);
      const submenu = document.getElementById(`mobile-${id}-menu`);
      const arrow = document.getElementById(`mobile-${id}-arrow`);
      if (!toggle || !submenu || !arrow) return;

      function toggleMenu(e) {
        e.preventDefault();
        e.stopPropagation();
        const isHidden = submenu.classList.contains('hidden');
        submenu.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180');
        toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      }

      toggle.addEventListener('click', toggleMenu);
      toggle.addEventListener('touchstart', toggleMenu, { passive: false });
    }

    if (button && menu) {
      button.addEventListener('click', toggleMobileMenu);
      button.addEventListener('touchstart', toggleMobileMenu, { passive: false });
    }

    document.querySelectorAll('[data-mobile-dropdown]').forEach((el) => {
      bindDropdown(el.getAttribute('data-mobile-dropdown'));
    });

    document.addEventListener('click', function(e) {
      if (menu && button && e.target instanceof Element) {
        if (!menu.contains(e.target) && !button.contains(e.target)) {
          menu.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
        }
      }
    });
  });
</script>
