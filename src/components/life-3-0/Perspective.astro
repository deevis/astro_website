---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  author: string;
  handle: string;
  postId: string;
  date: string;
  dateLabel: string;
  excerpt: string;
  quoted?: boolean;
}
const { id, eyebrow, title, author, handle, postId, date, dateLabel, excerpt, quoted = true } = Astro.props;
const url = `https://x.com/${handle}/status/${postId}`;
---

<aside class="life-perspective not-prose" id={id} aria-labelledby={`${id}-title`}>
  <div class="lp-context">
    <span class="lp-eyebrow">Voices in the debate <span aria-hidden="true">/</span> {eyebrow}</span>
    <h3 id={`${id}-title`}>{title}</h3>
    <div class="lp-analysis"><slot /></div>
    <a class="lp-source" href={url} target="_blank" rel="noopener noreferrer">Read the original on X <span aria-hidden="true">↗</span></a>
  </div>
  <life-x-post class="lp-post" data-post-id={postId}>
    <div class="lp-fallback">
      <span class="lp-excerpt-label">{quoted ? 'From the post' : 'Post in brief'}</span>
      {quoted ? <blockquote><p>{excerpt}</p></blockquote> : <p class="lp-summary">{excerpt}</p>}
      <div class="lp-attribution"><strong>{author}</strong><span>@{handle} · <time datetime={date}>{dateLabel}</time></span></div>
      <a href={url} target="_blank" rel="noopener noreferrer">View post{quoted ? '' : ' and video'} on X ↗</a>
    </div>
    <div class="lp-mount"></div>
  </life-x-post>
</aside>

<script>
  type XWidgets = { widgets: { createTweet: (id: string, target: HTMLElement, options: Record<string, unknown>) => Promise<HTMLElement | undefined> } };
  const xWindow = window as Window & { twttr?: XWidgets };
  let widgetsPromise: Promise<XWidgets> | undefined;

  function loadWidgets(): Promise<XWidgets> {
    if (xWindow.twttr?.widgets?.createTweet) return Promise.resolve(xWindow.twttr);
    if (!widgetsPromise) {
      widgetsPromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://platform.twitter.com/widgets.js';
        script.async = true;
        const timer = window.setTimeout(() => reject(new Error('X widgets unavailable')), 12000);
        script.onload = () => {
          window.clearTimeout(timer);
          if (xWindow.twttr?.widgets?.createTweet) resolve(xWindow.twttr);
          else reject(new Error('X widgets unavailable'));
        };
        script.onerror = () => { window.clearTimeout(timer); reject(new Error('X widgets unavailable')); };
        document.head.append(script);
      });
    }
    return widgetsPromise;
  }

  class LifeXPost extends HTMLElement {
    observer?: IntersectionObserver;
    themeObserver?: MutationObserver;
    generation = 0;
    started = false;
    theme = '';

    connectedCallback() {
      if (this.observer || this.started) return;
      const start = () => {
        this.started = true;
        this.observer?.disconnect();
        void this.renderPost();
        this.themeObserver = new MutationObserver(() => {
          const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
          if (theme !== this.theme) void this.renderPost();
        });
        this.themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      };
      if (!('IntersectionObserver' in window)) { start(); return; }
      this.observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) start();
      }, { rootMargin: '600px' });
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.generation++;
      this.observer?.disconnect();
      this.observer = undefined;
      this.themeObserver?.disconnect();
      this.started = false;
    }

    async renderPost() {
      const generation = ++this.generation;
      this.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      const fallback = this.querySelector<HTMLElement>('.lp-fallback')!;
      const mount = this.querySelector('.lp-mount')!.cloneNode(false) as HTMLElement;
      this.querySelector('.lp-mount')?.replaceWith(mount);
      fallback.hidden = false;
      this.dataset.state = 'loading';
      let timer: number | undefined;
      try {
        const api = await loadWidgets();
        if (generation !== this.generation || !this.isConnected) return;
        const widget = await Promise.race([
          api.widgets.createTweet(this.dataset.postId!, mount, {
            theme: this.theme, dnt: true, conversation: 'none', align: 'center', width: 550,
          }),
          new Promise<undefined>(resolve => { timer = window.setTimeout(() => resolve(undefined), 15000); }),
        ]);
        if (generation !== this.generation || !this.isConnected) return;
        if (!widget) throw new Error('Post unavailable');
        fallback.hidden = true;
        this.dataset.state = 'loaded';
      } catch {
        if (generation !== this.generation) return;
        // Detach the target so a late widget cannot replace the readable fallback.
        mount.replaceChildren();
        const emptyMount = mount.cloneNode(false) as HTMLElement;
        mount.replaceWith(emptyMount);
        this.dataset.state = 'fallback';
      } finally {
        window.clearTimeout(timer);
      }
    }
  }
  if (!customElements.get('life-x-post')) customElements.define('life-x-post', LifeXPost);
</script>

<style>
  .life-perspective { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(24px, 4vw, 48px); margin: 3rem 0; padding: clamp(22px, 3vw, 36px); border: 1px solid var(--lf-line); border-top: 3px solid var(--lf-amber); border-radius: 16px; background: var(--lf-paper); color: var(--lf-ink); scroll-margin-top: 7rem; }
  .lp-context, .lp-post { min-width: 0; }
  .lp-eyebrow { display: block; color: var(--lf-amber); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; line-height: 1.8; }
  .lp-eyebrow span { margin: 0 .4em; opacity: .6; }
  .lp-context h3 { color: var(--lf-ink); font: 650 clamp(23px, 2.4vw, 30px)/1.22 system-ui, sans-serif; letter-spacing: -.035em; margin: 18px 0; }
  .lp-analysis :global(p) { margin: 0 0 14px; color: var(--lf-muted); font-size: 15px; line-height: 1.75; }
  .lp-analysis :global(strong) { color: var(--lf-ink); }
  .lp-source, .lp-fallback a { display: inline-block; color: var(--lf-teal); font-size: 12px; line-height: 1.6; text-decoration: underline; text-underline-offset: 4px; }
  .lp-source { margin-top: 8px; }
  .lp-source span { margin-left: 6px; }
  .lp-post { display: block; position: relative; container-type: inline-size; }
  .lp-fallback { padding: 28px; border: 1px solid var(--lf-line); background: var(--lf-panel); border-radius: 12px; }
  .lp-fallback[hidden] { display: none; }
  .lp-excerpt-label { color: var(--lf-muted); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
  .lp-fallback blockquote { border: 0; padding: 0; margin: 20px 0; }
  .lp-fallback blockquote p { margin: 0; color: var(--lf-ink); font: 400 25px/1.4 Georgia, serif; }
  .lp-summary { margin: 18px 0; color: var(--lf-ink); font-size: 17px; line-height: 1.65; }
  .lp-attribution { display: grid; gap: 3px; padding-top: 18px; border-top: 1px solid var(--lf-line); font-size: 13px; }
  .lp-attribution strong { color: var(--lf-ink); }
  .lp-attribution span { color: var(--lf-muted); font-size: 11px; }
  .lp-fallback a { margin-top: 18px; }
  .lp-mount { width: 100%; }
  .lp-post:not([data-state='loaded']) .lp-mount { position: absolute; inset: 0 0 auto; visibility: hidden; }
  .lp-mount :global(.twitter-tweet) { margin: 0 auto !important; max-width: 100% !important; }
  @media (max-width: 760px) {
    .life-perspective { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 22px; }
    .lp-context h3 { font-size: 26px; }
    .lp-fallback { padding: 22px; }
  }
  @media (max-width: 420px) { .life-perspective { padding: 10px; } .lp-context { padding: 7px; } }
  /* X enforces a minimum frame width; preserve the readable excerpt below it. */
  @container (max-width: 299px) {
    .lp-mount { display: none; }
    .lp-fallback[hidden] { display: block; }
  }
  @media print { .lp-mount { display: none; } .lp-fallback[hidden] { display: block; } }
</style>
