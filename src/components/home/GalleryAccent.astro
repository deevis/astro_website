---
interface MediaItem {
  id: string;
  title: string;
  description: string;
  type: string;
  src?: string;
  videoId?: string;
  thumb: string;
  tags?: string[];
}

interface Props {
  items: MediaItem[];
  caption?: string;
}

const { items, caption = 'From the gallery' } = Astro.props;
---

<aside class="gallery-accent min-w-0 w-full max-w-full rounded-2xl overflow-hidden border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-800" data-gallery-accent>
  <a class="gallery-accent-link block group" href="/gallery">
    <div class="relative overflow-hidden">
      <img
        class="gallery-accent-thumb w-full max-w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105"
        src={items[0]?.thumb}
        alt={items[0]?.title ?? 'Gallery'}
        loading="lazy"
        decoding="async"
      />
      <div class="gallery-accent-play hidden absolute inset-0 items-center justify-center">
        <div class="bg-black/50 rounded-full p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
    </div>
    <div class="p-4">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-400 mb-1">{caption}</p>
      <h3 class="gallery-accent-title font-semibold text-gray-900 dark:text-white truncate">{items[0]?.title}</h3>
      <p class="gallery-accent-desc text-sm text-gray-500 dark:text-gray-400 line-clamp-2 mt-1">{items[0]?.description}</p>
      <p class="text-xs text-primary-600 dark:text-primary-400 mt-2">Open in gallery →</p>
    </div>
  </a>
</aside>

<script define:vars={{ items }}>
  (function () {
    const pool = items;
    if (!Array.isArray(pool) || pool.length === 0) return;

    const w = window;
    if (!w.__homeGalleryPool) {
      const shuffled = pool.slice();
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      w.__homeGalleryPool = shuffled;
      w.__homeGalleryIndex = 0;
    }

    const accents = document.querySelectorAll('[data-gallery-accent]');
    accents.forEach((accent) => {
      if (accent.dataset.filled === '1') return;
      const item = w.__homeGalleryPool[w.__homeGalleryIndex % w.__homeGalleryPool.length];
      w.__homeGalleryIndex += 1;
      accent.dataset.filled = '1';

      const link = accent.querySelector('.gallery-accent-link');
      const img = accent.querySelector('.gallery-accent-thumb');
      const title = accent.querySelector('.gallery-accent-title');
      const desc = accent.querySelector('.gallery-accent-desc');
      const play = accent.querySelector('.gallery-accent-play');

      if (link) link.setAttribute('href', `/gallery#media=${item.id}`);
      if (img) {
        img.setAttribute('src', item.thumb);
        img.setAttribute('alt', item.title);
      }
      if (title) title.textContent = item.title;
      if (desc) desc.textContent = item.description;
      if (play) {
        const isVideo = item.type === 'video' || item.type === 'youtube';
        play.classList.toggle('hidden', !isVideo);
        play.classList.toggle('flex', isVideo);
      }
    });
  })();
</script>
