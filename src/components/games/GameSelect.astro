---
import { gameGenres, type GameEntry } from '../../config/catalog';

interface Props {
  games: GameEntry[];
  startIndex: number;
}

const { games, startIndex } = Astro.props;
const featured = games[startIndex] ?? games[0];
const genreLabel = Object.fromEntries(gameGenres.map((genre) => [genre.id, genre.label]));
---

<section
  id="game-select"
  class="game-select container mx-auto px-4 md:px-6 lg:px-8 pb-16"
  data-start-index={startIndex}
  aria-label="Game Roulette"
>
  <ul class="game-icon-list" data-icon-list>
    {games.map((game, index) => (
      <li>
        <button
          type="button"
          class:list={['game-icon', { 'is-active': index === startIndex }]}
          data-index={index}
          data-id={game.id}
          aria-label={`${game.title}. ${game.tagline}`}
          aria-current={index === startIndex ? 'true' : undefined}
        >
          <span class="game-icon-frame">
            <img
              src={game.image}
              alt=""
              width="160"
              height="107"
              loading={Math.abs(index - startIndex) < 8 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </span>
          <span class="game-icon-tip" aria-hidden="true">{game.title}</span>
          <span class="game-icon-name">{game.title}</span>
        </button>
      </li>
    ))}
  </ul>

  <div class="game-select-stage grid lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.85fr)] gap-6 items-stretch">
    <div class="game-billboard-scene">
      <div class="game-billboard" data-billboard>
        <img
          data-art
          src={featured.image}
          alt=""
          width="960"
          height="640"
          class="game-billboard-art"
        />
        <p
          data-today-badge
          class="absolute top-3 left-3 m-0 px-2.5 py-1 rounded-full bg-primary-600 text-white text-[10px] font-semibold uppercase tracking-[0.16em]"
        >
          Today’s pick
        </p>
      </div>
    </div>

    <div class="flex h-full flex-col justify-center rounded-2xl border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-800 p-6 md:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-600 dark:text-primary-400 mb-3">
        <span data-index-label>{String(startIndex + 1).padStart(2, '0')}</span>
        <span class="text-gray-400 dark:text-gray-500"> / {String(games.length).padStart(2, '0')}</span>
        <span class="mx-2 text-gray-300 dark:text-gray-600">·</span>
        <span data-genre-label>{genreLabel[featured.genre]}</span>
      </p>
      <h2 data-title class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white leading-tight">
        {featured.title}
      </h2>
      <p data-tagline class="mt-2 text-lg text-gray-600 dark:text-gray-300">
        {featured.tagline}
      </p>
      <p data-description class="mt-4 text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
        {featured.description}
      </p>
      <ul data-bullets class="mt-4 space-y-1.5 text-sm text-gray-600 dark:text-gray-300">
        {featured.bullets.map((bullet) => (
          <li class="flex gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-primary-500 shrink-0"></span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
      <div class="mt-6">
        <a
          data-play
          href={featured.href}
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition-colors"
        >
          {featured.playLabel}
        </a>
      </div>
    </div>
  </div>
  <div class="game-spin-wrap mt-8 flex justify-center">
    <button type="button" id="game-spin" class="game-spin">Spin</button>
  </div>
</section>

<script type="application/json" id="games-index-data" set:html={JSON.stringify(games)} />

<style>
  .game-billboard-scene {
    overflow: hidden;
    border-radius: 1rem;
  }

  .game-billboard {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgb(229 231 235);
    background: rgb(243 244 246);
    min-height: 16rem;
  }

  :global(.dark) .game-billboard {
    border-color: #374151;
    background: #111827;
  }

  .game-billboard-art {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: top;
    transition: opacity 0.25s ease;
  }

  .game-billboard.is-swapping .game-billboard-art {
    opacity: 0.4;
  }

  .game-select.is-spinning .game-billboard-art {
    filter: blur(3px);
    transition: none;
  }

  .game-select.is-spinning .game-icon {
    pointer-events: none;
  }

  .game-select.is-spinning .game-icon.is-active {
    transform: scale(1.08);
  }

  .game-spin {
    position: relative;
    margin-top: 0;
    min-width: 11rem;
    padding: 0.95rem 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgb(29 78 216);
    background: linear-gradient(180deg, #7dd3fc 0%, #3b82f6 38%, #1d4ed8 100%);
    color: white;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 10px 22px rgb(37 99 235 / 0.32);
    overflow: hidden;
    cursor: pointer;
  }

  .game-spin::before {
    content: "";
    position: absolute;
    left: 14%;
    right: 14%;
    top: 4px;
    height: 42%;
    border-radius: 9999px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.62), transparent);
    pointer-events: none;
  }

  .game-spin:hover:not(:disabled) {
    filter: brightness(1.08);
  }

  .game-spin:disabled {
    cursor: default;
    opacity: 0.72;
  }

  .game-icon-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    list-style: none;
    margin: 0 0 3.25rem;
    padding: 0.75rem 0 0;
  }

  .game-icon-list li {
    width: 5.75rem;
    flex: 0 0 5.75rem;
  }

  .game-icon {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 0.75rem;
    overflow: visible;
    border: 1px solid rgb(229 231 235);
    background: rgb(243 244 246);
    cursor: pointer;
    touch-action: manipulation;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  :global(.dark) .game-icon {
    border-color: #374151;
    background: #111827;
  }

  .game-icon-frame {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.7rem;
    background: rgb(229 231 235);
  }

  :global(.dark) .game-icon-frame {
    background: #374151;
  }

  .game-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .game-icon:focus-visible {
    border-color: rgb(96 165 250);
    transform: translateY(-2px);
  }

  .game-icon.is-active {
    border-color: rgb(37 99 235);
    box-shadow: 0 0 0 2px rgb(37 99 235 / 0.35);
  }

  .game-icon-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.45rem);
    transform: translateX(-50%);
    z-index: 20;
    max-width: 14rem;
    padding: 0.3rem 0.55rem;
    border-radius: 0.4rem;
    background: rgb(17 24 39);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease;
  }

  .game-icon-name {
    display: none;
  }

  .game-select.is-spinning .game-icon-tip {
    opacity: 0;
    visibility: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .game-icon:hover {
      border-color: rgb(96 165 250);
      transform: translateY(-2px);
    }

    .game-icon:hover .game-icon-tip {
      opacity: 1;
      visibility: visible;
    }
  }

  .game-icon:focus-visible .game-icon-tip {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 767px) {
    .game-select {
      display: flex;
      flex-direction: column;
    }

    .game-select-stage {
      order: 1;
    }

    .game-spin-wrap {
      order: 2;
      margin-top: 1.25rem;
    }

    .game-icon-list {
      order: 3;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0.65rem;
      margin: 1.25rem 0 0;
      padding: 0.25rem 0 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .game-icon-list::-webkit-scrollbar {
      display: none;
    }

    .game-icon-list li {
      width: 5.25rem;
      flex: 0 0 5.25rem;
      scroll-snap-align: start;
    }

    .game-icon,
    :global(.dark) .game-icon {
      background: transparent;
      border-color: transparent;
    }

    .game-icon-name {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      margin-top: 0.35rem;
      padding: 0 0.05rem;
      font-size: 0.65rem;
      font-weight: 600;
      line-height: 1.25;
      text-align: center;
      color: rgb(75 85 99);
    }

    :global(.dark) .game-icon-name {
      color: rgb(156 163 175);
    }

    .game-icon.is-active .game-icon-name {
      color: rgb(37 99 235);
    }

    :global(.dark) .game-icon.is-active .game-icon-name {
      color: rgb(147 197 253);
    }

    .game-billboard {
      min-height: 0;
    }

    .game-spin {
      width: 100%;
      max-width: 22rem;
    }

    .game-select :global([data-play]) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-billboard-art,
    .game-icon {
      transition: none;
    }
  }
</style>

<script>
  type GameGenre = 'adventure' | 'strategy' | 'puzzle' | 'trainer';

  type GameRecord = {
    id: string;
    title: string;
    tagline: string;
    description: string;
    href: string;
    playLabel: string;
    bullets: string[];
    image?: string;
    genre: GameGenre;
  };

  const root = document.getElementById('game-select');
  const dataEl = document.getElementById('games-index-data');
  if (root && dataEl) {
    const games = JSON.parse(dataEl.textContent || '[]') as GameRecord[];
    const icons = [...root.querySelectorAll<HTMLButtonElement>('.game-icon')];
    const billboard = root.querySelector<HTMLElement>('[data-billboard]');
    const art = root.querySelector<HTMLImageElement>('[data-art]');
    const todayBadge = root.querySelector<HTMLElement>('[data-today-badge]');
    const indexLabel = root.querySelector<HTMLElement>('[data-index-label]');
    const genreLabel = root.querySelector<HTMLElement>('[data-genre-label]');
    const titleEl = root.querySelector<HTMLElement>('[data-title]');
    const taglineEl = root.querySelector<HTMLElement>('[data-tagline]');
    const descriptionEl = root.querySelector<HTMLElement>('[data-description]');
    const bulletsEl = root.querySelector<HTMLElement>('[data-bullets]');
    const playEl = root.querySelector<HTMLAnchorElement>('[data-play]');
    const spinBtn = document.getElementById('game-spin');

    const genreNames: Record<GameGenre, string> = {
      adventure: 'Adventure',
      strategy: 'Strategy',
      puzzle: 'Puzzle',
      trainer: 'Trainer',
    };

    const startIndex = Number(root.dataset.startIndex || '0');
    let selected = Number.isFinite(startIndex) ? startIndex : 0;
    let spinning = false;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const hashId = window.location.hash.replace(/^#/, '');
    if (hashId) {
      const hashed = games.findIndex((game) => game.id === hashId);
      if (hashed >= 0) selected = hashed;
    }

    function layoutIcons(scrollIntoView = false) {
      icons.forEach((icon, index) => {
        icon.classList.toggle('is-active', index === selected);
        if (index === selected) icon.setAttribute('aria-current', 'true');
        else icon.removeAttribute('aria-current');
      });
      if (scrollIntoView && !spinning) {
        icons[selected]?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
      }
    }

    function renderDetails(instant = false) {
      const game = games[selected];
      if (!game) return;

      if (art && art.getAttribute('src') !== game.image) {
        if (reduceMotion || instant) {
          art.src = game.image || '';
          billboard?.classList.remove('is-swapping');
        } else {
          billboard?.classList.add('is-swapping');
          window.setTimeout(() => {
            art.src = game.image || '';
            billboard?.classList.remove('is-swapping');
          }, 140);
        }
      }

      if (todayBadge) todayBadge.classList.toggle('hidden', selected !== startIndex);
      if (indexLabel) indexLabel.textContent = String(selected + 1).padStart(2, '0');
      if (genreLabel) genreLabel.textContent = genreNames[game.genre];
      if (titleEl) titleEl.textContent = game.title;
      if (taglineEl) taglineEl.textContent = game.tagline;
      if (descriptionEl) descriptionEl.textContent = game.description;
      if (playEl) {
        playEl.href = game.href;
        playEl.textContent = game.playLabel;
      }
      if (bulletsEl) {
        bulletsEl.replaceChildren(
          ...game.bullets.map((bullet) => {
            const item = document.createElement('li');
            item.className = 'flex gap-2';
            const dot = document.createElement('span');
            dot.className = 'mt-1.5 h-1.5 w-1.5 rounded-full bg-primary-500 shrink-0';
            const text = document.createElement('span');
            text.textContent = bullet;
            item.append(dot, text);
            return item;
          })
        );
        bulletsEl.classList.toggle('hidden', game.bullets.length === 0);
      }

      const nextHash = `#${game.id}`;
      if (window.location.hash !== nextHash) {
        history.replaceState(null, '', nextHash);
      }
    }

    function select(index: number, instant = false) {
      if (index < 0 || index >= games.length) return;
      selected = index;
      layoutIcons(!instant);
      renderDetails(instant);
    }

    function spinTo(target: number) {
      const count = games.length;
      if (count < 2 || spinning) return;
      if (reduceMotion) {
        select(target);
        return;
      }

      let distance = (target - selected + count) % count;
      if (distance === 0) distance = count;
      const total = distance + count * 2;
      spinning = true;
      root.classList.add('is-spinning');
      if (spinBtn instanceof HTMLButtonElement) {
        spinBtn.disabled = true;
        spinBtn.textContent = 'Spinning…';
      }

      let step = 0;
      let cursor = selected;
      const tick = () => {
        cursor = (cursor + 1) % count;
        step += 1;
        const last = step === total;
        select(cursor, !last);
        if (last) {
          spinning = false;
          root.classList.remove('is-spinning');
          if (spinBtn instanceof HTMLButtonElement) {
            spinBtn.disabled = false;
            spinBtn.textContent = 'Spin';
          }
          return;
        }
        const progress = step / total;
        const delay = 32 + progress ** 2.6 * 280;
        window.setTimeout(tick, delay);
      };
      window.setTimeout(tick, 32);
    }

    icons.forEach((icon) => {
      icon.addEventListener('click', () => {
        if (spinning) return;
        select(Number(icon.dataset.index));
      });
    });

    spinBtn?.addEventListener('click', () => {
      const pool = games.map((_, index) => index).filter((index) => index !== selected);
      if (!pool.length || spinning) return;
      spinTo(pool[Math.floor(Math.random() * pool.length)]);
    });

    layoutIcons();
    renderDetails();
  }
</script>
