---
import { apps, bitcoinResources, developerTools } from '../config/catalog';
import { showcases } from '../config/showcases.json';
import { homeGameSlides, type ShowcaseItem } from '../lib/showcases';

const currentYear = new Date().getFullYear();
const gameLinks = homeGameSlides(showcases as ShowcaseItem[]);

const siteLinks = [
  { href: '/', text: 'Home' },
  { href: '/games', text: 'Games' },
  { href: '/articles', text: 'Articles' },
  { href: '/playground', text: 'Playground' },
  { href: '/news', text: 'News' },
  { href: '/gallery', text: 'Gallery' },
  { href: '/about', text: 'About Me' },
  { href: 'https://www.redbubble.com/people/ai-depot/shop', text: 'Shop', external: true },
];

const connectLinks = [
  { href: '/contact', text: 'Contact Me' },
  { href: 'https://www.linkedin.com/in/darrenhicks/', text: 'LinkedIn', external: true },
  { href: 'https://github.com/deevis', text: 'GitHub', external: true },
  { href: 'https://stackoverflow.com/users/59075/darren-hicks', text: 'Stack Overflow', external: true },
  { href: 'https://www.hackerrank.com/profile/darren_hicks', text: 'HackerRank', external: true },
  { href: 'https://x.com/deevis', text: 'Twitter', external: true },
  { href: 'https://www.instagram.com/deepdream_inception/', text: 'Instagram', external: true },
];

const headingClass = 'text-sm font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-300 mb-3';
const footerLink = 'block text-sm py-0.5 text-gray-700 dark:text-gray-300 hover:text-primary-500 dark:hover:text-primary-300 transition-colors';
---

<script src="/js/dbh-dev-console.js" is:inline></script>
<footer class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white py-10 transition-colors duration-200">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-8">
      <div>
        <h3 class={headingClass}>Site</h3>
        {siteLinks.map((item) => (
          item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class={footerLink}>{item.text}</a>
          ) : (
            <a href={item.href} class={footerLink}>{item.text}</a>
          )
        ))}
      </div>

      <div>
        <h3 class={headingClass}>Games</h3>
        <a href="/games" class={footerLink}>All games</a>
        {gameLinks.map((game) => (
          <a href={game.href} class={footerLink}>{game.title}</a>
        ))}
      </div>

      <div>
        <h3 class={headingClass}>Apps</h3>
        {apps.map((item) => (
          <a href={item.href} class={footerLink}>{item.title}</a>
        ))}
      </div>

      <div>
        <h3 class={headingClass}>Developer Tools</h3>
        {developerTools.map((item) => (
          <a href={item.href} class={footerLink}>{item.title}</a>
        ))}
      </div>

      <div>
        <h3 class={headingClass}>Bitcoin</h3>
        {bitcoinResources.map((item) => (
          <a href={item.href} class={footerLink}>{item.title}</a>
        ))}
      </div>

      <div>
        <h3 class={headingClass}>Connect</h3>
        {connectLinks.map((item) => (
          item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class={footerLink}>{item.text}</a>
          ) : (
            <a href={item.href} class={footerLink}>{item.text}</a>
          )
        ))}
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-300 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-sm text-gray-600 dark:text-gray-400">
      <p>me@darrenhicks.dev · Salt Lake City, Utah</p>
      <p>&copy; {currentYear} Darren Hicks. All rights reserved.</p>
    </div>
  </div>
</footer>
