---
---

<button
  id="ticker-toggle"
  type="button"
  class="p-2 rounded-lg text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700"
  aria-label="Hide news ticker"
  aria-pressed="true"
>
  <svg
    id="ticker-toggle-on-icon"
    class="w-5 h-5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
  </svg>
  <svg
    id="ticker-toggle-off-icon"
    class="hidden w-5 h-5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
    <path stroke-linecap="round" d="M4 4l16 16" />
  </svg>
</button>

<script>
  const STORAGE_KEY = 'news-ticker';

  function tickerIsHidden() {
    return document.documentElement.classList.contains('ticker-hidden');
  }

  function applyTickerVisibility(hidden: boolean) {
    const button = document.getElementById('ticker-toggle');
    const onIcon = document.getElementById('ticker-toggle-on-icon');
    const offIcon = document.getElementById('ticker-toggle-off-icon');

    document.documentElement.classList.toggle('ticker-hidden', hidden);
    localStorage.setItem(STORAGE_KEY, hidden ? 'off' : 'on');

    onIcon?.classList.toggle('hidden', hidden);
    offIcon?.classList.toggle('hidden', !hidden);

    if (button) {
      button.setAttribute('aria-pressed', hidden ? 'false' : 'true');
      button.setAttribute('aria-label', hidden ? 'Show news ticker' : 'Hide news ticker');
    }

    window.dispatchEvent(new Event('news-ticker-change'));
    requestAnimationFrame(() => window.dispatchEvent(new Event('news-ticker-change')));
  }

  function initTickerToggle() {
    const button = document.getElementById('ticker-toggle');
    if (!button || button.dataset.bound === '1') return;
    button.dataset.bound = '1';

    applyTickerVisibility(localStorage.getItem(STORAGE_KEY) === 'off');
    button.addEventListener('click', () => applyTickerVisibility(!tickerIsHidden()));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTickerToggle);
  } else {
    initTickerToggle();
  }
</script>
